module
public import AlgebraicAnalysis.DifferentialOperators.CoordinateSymbol
public import Mathlib.RingTheory.Kaehler.Basic
public import Mathlib.Algebra.Module.Projective
public import Mathlib.RingTheory.FiniteType
public import Mathlib.RingTheory.KrullDimension.Polynomial
public import Mathlib.RingTheory.KrullDimension.Field

@[expose] public section

/-!
# Differential operators when `Ω_{R/k}` is projective

A **projective frame** of the commutative `k`-algebra `R`
(`DifferentialOperators.IsProjectiveFrame x E`) consists of algebra generators
`x₁, …, x_r` of `R` and derivations `E₁, …, E_r` with

  `d b = ∑ᵢ Eᵢ(b) d xᵢ` in `Ω_{R/k}` for every `b ∈ R`.

Equivalently, `ω ↦ (Eᵢ ω)ᵢ` splits the surjection `Rʳ ↠ Ω_{R/k}`,
`eᵢ ↦ d xᵢ`. Unlike a coordinate frame, the `Eᵢ` need not be dual to the
`xᵢ`; the matrix `Eᵢ(xⱼ)` is only idempotent. A finitely generated algebra has
a projective frame exactly when `Ω_{R/k}` is projective
(`exists_isProjectiveFrame`), for instance when `R` is smooth over `k`.

## Main results

* `IsProjectiveFrame.derivation_eq_sum`: every derivation `D : R → M` into an
  `R`-module satisfies `D b = ∑ᵢ Eᵢ(b) D(xᵢ)`.
* `IsProjectiveFrame.nsmul_sub_sum_mem_orderBelow` (**Euler identity modulo
  lower order**, any characteristic): for `P` of order at most `m`,
  `m P - ∑ᵢ [P, xᵢ] Eᵢ` has order at most `m - 1`.
* Characteristic zero: the order filtration of `D_k(R)` is generated in degree
  one by the `Eᵢ` over `R` (`IsProjectiveFrame.polynomialGenerators`), so
  `R[ξ₁, …, ξ_r] ↠ gr D_k(R)`. Hence `D_k(R)` is generated by `R` and the
  `Eᵢ`, and if `R` is Noetherian of Krull dimension at most `d`, `D_k(R)` is
  right and left Noetherian with deviation at most `d + r` on both sides.
* `exists_isProjectiveFrame`, `ringKrullDim_le_of_adjoin_eq_top`: a finitely
  generated algebra with projective `Ω` generated by `r` elements has a
  projective frame of length `r` and Krull dimension at most `r`, so
  (`devLE_right_of_adjoin_eq_top`, `devLE_left_of_adjoin_eq_top`) `D_k(R)` has
  deviation at most `2r`.

## Proof of the Euler identity

The map `b ↦ [P, b]` is a derivation modulo lower order: for `P` of order at
most `n + 1` the classes of `[P, b]` in `order n / orderBelow n` satisfy
Leibniz, since `[P, a] b - b [P, a] = [[P, a], b]` drops the order. Therefore
`[P, b] ≡ ∑ᵢ Eᵢ(b) [P, xᵢ]` (`commutator_sub_sum_mem_orderBelow`). The
induction then runs as for coordinate frames
(`IsCoordinateFrame.nsmul_sub_sum_mem_orderBelow`), using the commutator test
on algebra generators.

## References

[EGA IV] A. Grothendieck, *Éléments de géométrie algébrique IV*, 16.11.2
(differential operators of a differentially smooth algebra).
The argument via projective frames is AA-native.
-/

namespace AlgebraicAnalysis.DifferentialOperators

open RingFiltration

section Commutator

variable {k R : Type*} [CommRing k] [CommRing R] [Algebra k R]

theorem commutator_smul_right (P : End (k := k) (R := R)) (c : k) (b : R) :
    commutator P (c • b) = c • commutator P b := by
  ext y
  simp [commutator_apply, smul_sub]

/-- `b ↦ [P, b]` as a `k`-linear map. -/
def commutatorLinearMap (P : End (k := k) (R := R)) : R →ₗ[k] End (k := k) (R := R) where
  toFun b := commutator P b
  map_add' := commutator_add_right P
  map_smul' := commutator_smul_right P

@[simp] theorem commutatorLinearMap_apply (P : End (k := k) (R := R)) (b : R) :
    commutatorLinearMap P b = commutator P b := rfl

/-- The left `R`-module structure of `End_k(R)` is composition with
multiplications on the left. -/
theorem smul_eq_multiplication_mul (r : R) (Q : End (k := k) (R := R)) :
    r • Q = multiplication r * Q := by
  ext y
  simp

/-- `orderBelow n` as a left `R`-submodule of `End_k(R)`. -/
def orderBelowSubmodule (n : ℕ) : Submodule R (End (k := k) (R := R)) where
  carrier := orderBelow (k := k) (R := R) n
  add_mem' := add_mem
  zero_mem' := zero_mem _
  smul_mem' r Q hQ := by
    change r • Q ∈ orderBelow (k := k) (R := R) n
    rw [smul_eq_multiplication_mul]
    exact multiplication_mul_mem_orderBelow r hQ

/-- The classes of `[P, b]` modulo `orderBelow n`, as a `k`-linear map in `b`. -/
noncomputable def commutatorClass (n : ℕ) (P : End (k := k) (R := R)) :
    R →ₗ[k] End (k := k) (R := R) ⧸ orderBelowSubmodule (k := k) (R := R) n :=
  ((orderBelowSubmodule (k := k) (R := R) n).mkQ.restrictScalars k).comp (commutatorLinearMap P)

theorem commutatorClass_apply (n : ℕ) (P : End (k := k) (R := R)) (b : R) :
    commutatorClass n P b = Submodule.Quotient.mk (commutator P b) := rfl

/-- For `P` of order at most `n + 1`, the classes of `[P, b]` modulo
`orderBelow n` form a `k`-derivation of `R`. -/
noncomputable def commutatorDerivation {n : ℕ} {P : End (k := k) (R := R)}
    (hP : P ∈ order (n + 1)) :
    Derivation k R (End (k := k) (R := R) ⧸ orderBelowSubmodule (k := k) (R := R) n) :=
  Derivation.mk' (commutatorClass n P) fun a b => by
    rw [commutatorClass_apply, commutatorClass_apply, commutatorClass_apply,
      ← Submodule.Quotient.mk_smul, ← Submodule.Quotient.mk_smul, ← Submodule.Quotient.mk_add,
      Submodule.Quotient.eq, smul_eq_multiplication_mul, smul_eq_multiplication_mul,
      commutator_mul_right]
    have h := mem_order_iff_commutator_mem_orderBelow.mp ((mem_order_succ_iff P n).mp hP a) b
    have heq : commutator P a * multiplication b + multiplication a * commutator P b -
        (multiplication a * commutator P b + multiplication b * commutator P a) =
        commutator (commutator P a) b := by
      ext y
      simp only [LinearMap.sub_apply, LinearMap.add_apply, Module.End.mul_apply,
        multiplication_apply, commutator_apply]
      ring
    change _ ∈ orderBelow (k := k) (R := R) n
    rw [heq]
    exact h

theorem commutatorDerivation_apply {n : ℕ} {P : End (k := k) (R := R)}
    (hP : P ∈ order (n + 1)) (b : R) :
    commutatorDerivation hP b = Submodule.Quotient.mk (commutator P b) := rfl

end Commutator

section Frame

variable {k R σ : Type*} [CommRing k] [CommRing R] [Algebra k R] [Fintype σ]

/-- A **projective frame** of the commutative `k`-algebra `R`: algebra
generators `x₁, …, x_r` and derivations `E₁, …, E_r` with
`d b = ∑ᵢ Eᵢ(b) d xᵢ` in `Ω_{R/k}`. The `Eᵢ` split `Rʳ ↠ Ω_{R/k}`, so
`Ω_{R/k}` is projective. -/
structure IsProjectiveFrame (x : σ → R) (E : σ → Derivation k R R) : Prop where
  /-- The `xᵢ` generate `R` as a `k`-algebra. -/
  adjoin_eq_top : Algebra.adjoin k (Set.range x) = ⊤
  /-- `d b = ∑ᵢ Eᵢ(b) d xᵢ` in the Kähler differentials. -/
  D_eq_sum : ∀ b, KaehlerDifferential.D k R b = ∑ i, E i b • KaehlerDifferential.D k R (x i)

namespace IsProjectiveFrame

variable {x : σ → R} {E : σ → Derivation k R R} (hF : IsProjectiveFrame x E)
include hF

/-- Every derivation `D : R → M` into an `R`-module satisfies
`D b = ∑ᵢ Eᵢ(b) D(xᵢ)`. -/
theorem derivation_eq_sum {M : Type*} [AddCommGroup M] [Module R M] [Module k M]
    [IsScalarTower k R M] (D : Derivation k R M) (b : R) : D b = ∑ i, E i b • D (x i) := by
  rw [← D.liftKaehlerDifferential_comp_D b, hF.D_eq_sum b, map_sum]
  simp [Derivation.liftKaehlerDifferential_comp_D]

/-- **Commutators modulo lower order.** For `P` of order at most `n + 1`,
`[P, b] - ∑ᵢ Eᵢ(b) [P, xᵢ]` has order at most `n - 1`. -/
theorem commutator_sub_sum_mem_orderBelow {n : ℕ} {P : End (k := k) (R := R)}
    (hP : P ∈ order (n + 1)) (b : R) :
    commutator P b - ∑ i, multiplication (E i b) * commutator P (x i) ∈ orderBelow n := by
  have h := hF.derivation_eq_sum (commutatorDerivation hP) b
  simp only [commutatorDerivation_apply, ← Submodule.Quotient.mk_smul,
    smul_eq_multiplication_mul] at h
  have hsum := map_sum (orderBelowSubmodule (k := k) (R := R) n).mkQ
    (fun i => multiplication (E i b) * commutator P (x i)) Finset.univ
  simp only [Submodule.mkQ_apply] at hsum
  rw [← hsum, Submodule.Quotient.eq] at h
  exact h

/-- The same with the multiplications on the right: `[P, b] - ∑ᵢ [P, xᵢ] Eᵢ(b)`
has order at most `n - 1`. -/
theorem commutator_sub_sum_mul_mem_orderBelow {n : ℕ} {P : End (k := k) (R := R)}
    (hP : P ∈ order (n + 1)) (b : R) :
    commutator P b - ∑ i, commutator P (x i) * multiplication (E i b) ∈ orderBelow n := by
  have hswap : ∀ i, multiplication (E i b) * commutator P (x i) -
      commutator P (x i) * multiplication (E i b) ∈ orderBelow n := fun i => by
    have h := mem_order_iff_commutator_mem_orderBelow.mp
      ((mem_order_succ_iff P n).mp hP (x i)) (E i b)
    rw [← neg_mem_iff, neg_sub]
    exact h
  have heq : commutator P b - ∑ i, commutator P (x i) * multiplication (E i b) =
      (commutator P b - ∑ i, multiplication (E i b) * commutator P (x i)) +
        ∑ i, (multiplication (E i b) * commutator P (x i) -
          commutator P (x i) * multiplication (E i b)) := by
    rw [Finset.sum_sub_distrib]
    abel
  rw [heq]
  exact add_mem (hF.commutator_sub_sum_mem_orderBelow hP b)
    (Submodule.sum_mem _ fun i _ => hswap i)

/-- **Euler identity modulo lower order.** For an operator `P` of order at most
`m`, `m P - ∑ᵢ [P, xᵢ] Eᵢ` lies in `orderBelow m`. Holds in every
characteristic. -/
theorem nsmul_sub_sum_mem_orderBelow :
    ∀ m, ∀ P ∈ order (k := k) (R := R) m,
      m • P - ∑ i, commutator P (x i) * (E i).toLinearMap ∈ orderBelow m := by
  intro m
  induction m with
  | zero =>
      intro P hP
      rw [mem_order_zero_iff] at hP
      simp [hP]
  | succ n ih =>
      intro P hP
      rw [orderBelow_succ, mem_order_iff_commutator_mem_orderBelow]
      refine commutator_mem_of_adjoin hF.adjoin_eq_top _
        (fun a _ hQ => multiplication_mul_mem_orderBelow a hQ)
        (fun a _ hQ => mul_multiplication_mem_orderBelow a hQ) fun l => ?_
      have key : commutator ((n + 1) • P - ∑ i, commutator P (x i) * (E i).toLinearMap) (x l) =
          (n • commutator P (x l) -
            ∑ i, commutator (commutator P (x l)) (x i) * (E i).toLinearMap) +
          (commutator P (x l) -
            ∑ i, commutator P (x i) * multiplication (E i (x l))) := by
        rw [commutator_sub, commutator_nsmul, commutator_sum]
        simp only [commutator_mul, commutator_derivation, Finset.sum_add_distrib,
          commutator_commutator_comm P (x _) (x l)]
        rw [succ_nsmul]
        abel
      rw [key]
      exact add_mem (ih _ ((mem_order_succ_iff P n).mp hP (x l)))
        (hF.commutator_sub_sum_mul_mem_orderBelow hP (x l))

end IsProjectiveFrame

end Frame

section Presentation

variable {k R σ : Type*} [Field k] [CharZero k] [CommRing R] [Algebra k R]
  [Fintype σ] {x : σ → R} {E : σ → Derivation k R R}

namespace IsProjectiveFrame

variable (hF : IsProjectiveFrame x E)
include hF

/-- **Filtered generation by the frame derivations** (characteristic zero). If
`P` has order at most `n + 1`, then `P - ∑ᵢ ((n+1)⁻¹ [P, xᵢ]) Eᵢ` has order at
most `n`. -/
theorem sub_sum_mem_order {n : ℕ} {P : End (k := k) (R := R)} (hP : P ∈ order (n + 1)) :
    P - ∑ i, (((n : k) + 1)⁻¹ • commutator P (x i)) * (E i).toLinearMap ∈ order n := by
  have h := (order n).smul_mem ((n : k) + 1)⁻¹ (hF.nsmul_sub_sum_mem_orderBelow (n + 1) P hP)
  have hne : ((n : k) + 1) ≠ 0 := by exact_mod_cast Nat.succ_ne_zero n
  convert h using 1
  rw [smul_sub, Finset.smul_sum, ← Nat.cast_smul_eq_nsmul k, smul_smul, Nat.cast_add,
    Nat.cast_one, inv_mul_cancel₀ hne, one_smul]
  simp only [smul_mul_assoc]

/-- **The order filtration of `D_k(R)` is generated in degree one** by the frame
derivations over `R`: the hypotheses of a polynomial presentation
`R[ξ_σ] ↠ gr D_k(R)`, `ξᵢ ↦ [Eᵢ]`. -/
theorem polynomialGenerators :
    (orderFiltration (k := k) (R := R)).PolynomialGenerators (multiplicationAlgHom k R)
      (fun i => derivationElem (E i)) where
  grCommutative := orderFiltration_grCommutative
  map_mem a := multiplication_mem_order_zero a
  exists_map_eq P hP := ⟨P.1 1, Subtype.ext ((mem_order_zero_iff_eq_multiplication _).mp hP).symm⟩
  gen_mem i := derivation_mem_order_one (E i)
  exists_sum_mul n P hP := by
    refine ⟨fun i => ⟨((n : k) + 1)⁻¹ • commutator P.1 (x i), n,
      (order n).smul_mem _ ((mem_order_succ_iff P.1 n).mp hP (x i))⟩,
      fun i => (order n).smul_mem _ ((mem_order_succ_iff P.1 n).mp hP (x i)), ?_⟩
    rw [mem_orderFiltration_F]
    simpa using hF.sub_sum_mem_order hP

/-- **`D_k(R)` is generated by `R` and the frame derivations.** -/
theorem adjoin_eq_top_diffOp :
    Algebra.adjoin k (Set.range (multiplicationAlgHom k R) ∪
      Set.range fun i => derivationElem (E i)) = ⊤ :=
  hF.polynomialGenerators.adjoin_eq_top

variable [IsNoetherianRing R]

/-- `D_k(R)` is right Noetherian. -/
theorem isNoetherian_right :
    IsNoetherian (algebra (k := k) (R := R))ᵐᵒᵖ (algebra (k := k) (R := R)) :=
  hF.polynomialGenerators.isNoetherian_right

/-- `D_k(R)` is left Noetherian. -/
theorem isNoetherianRing : IsNoetherianRing (algebra (k := k) (R := R)) :=
  hF.polynomialGenerators.isNoetherianRing

/-- If `dim R ≤ d`, the right ideals of `D_k(R)` have deviation at most `d + r`. -/
theorem devLE_right {d : ℕ} (hR : ringKrullDim R ≤ d) :
    Module.DevLE (algebra (k := k) (R := R))ᵐᵒᵖ (d + Nat.card σ) (algebra (k := k) (R := R)) :=
  hF.polynomialGenerators.devLE_right hR

/-- If `dim R ≤ d`, the left ideals of `D_k(R)` have deviation at most `d + r`. -/
theorem devLE_left {d : ℕ} (hR : ringKrullDim R ≤ d) :
    Module.DevLE (algebra (k := k) (R := R)) (d + Nat.card σ) (algebra (k := k) (R := R)) :=
  hF.polynomialGenerators.devLE_left hR

/-- If `R` has finite Krull dimension, the right ideals of `D_k(R)` have
deviation at most omega. -/
theorem devLEOmega_right {d : ℕ} (hR : ringKrullDim R ≤ d) :
    Module.DevLEOmega (algebra (k := k) (R := R))ᵐᵒᵖ (algebra (k := k) (R := R)) :=
  hF.polynomialGenerators.devLEOmega_right hR

/-- If `R` has finite Krull dimension, the left ideals of `D_k(R)` have
deviation at most omega. -/
theorem devLEOmega_left {d : ℕ} (hR : ringKrullDim R ≤ d) :
    Module.DevLEOmega (algebra (k := k) (R := R)) (algebra (k := k) (R := R)) :=
  hF.polynomialGenerators.devLEOmega_left hR

end IsProjectiveFrame

end Presentation

section Existence

variable {k R : Type*} [CommRing k] [CommRing R] [Algebra k R]

/-- If `x₁, …, x_r` generate `R`, the differentials `d xᵢ` span `Ω_{R/k}`. -/
theorem span_D_eq_top_of_adjoin_eq_top {σ : Type*} {x : σ → R}
    (hx : Algebra.adjoin k (Set.range x) = ⊤) :
    Submodule.span R (Set.range fun i => KaehlerDifferential.D k R (x i)) = ⊤ := by
  set N := Submodule.span R (Set.range fun i => KaehlerDifferential.D k R (x i))
  let T : Subalgebra k R :=
    { carrier := {b | KaehlerDifferential.D k R b ∈ N}
      mul_mem' := fun {a b} ha hb => by
        rw [Set.mem_ofPred_eq, Derivation.leibniz]
        exact add_mem (N.smul_mem a hb) (N.smul_mem b ha)
      add_mem' := fun {a b} ha hb => by
        rw [Set.mem_ofPred_eq, map_add]
        exact add_mem ha hb
      algebraMap_mem' := fun c => by
        rw [Set.mem_ofPred_eq, Derivation.map_algebraMap]
        exact zero_mem _ }
  have hT : (⊤ : Subalgebra k R) ≤ T :=
    hx ▸ Algebra.adjoin_le (by rintro _ ⟨i, rfl⟩; exact Submodule.subset_span ⟨i, rfl⟩)
  rw [eq_top_iff, ← KaehlerDifferential.span_range_derivation, Submodule.span_le]
  rintro _ ⟨b, rfl⟩
  exact hT Algebra.mem_top

/-- **Projective frames exist** when `Ω_{R/k}` is projective: any finite family
of algebra generators extends to a projective frame, the derivations being
the coordinates of a splitting of `Rʳ ↠ Ω_{R/k}`. -/
theorem exists_isProjectiveFrame [Module.Projective R (Ω[R⁄k])] {σ : Type*} [Fintype σ]
    {x : σ → R} (hx : Algebra.adjoin k (Set.range x) = ⊤) :
    ∃ E : σ → Derivation k R R, IsProjectiveFrame x E := by
  let π : (σ → R) →ₗ[R] Ω[R⁄k] := Fintype.linearCombination R fun i => KaehlerDifferential.D k R (x i)
  have hπ : Function.Surjective π := by
    rw [← LinearMap.range_eq_top, Fintype.range_linearCombination]
    exact span_D_eq_top_of_adjoin_eq_top hx
  obtain ⟨s, hs⟩ := Module.projective_lifting_property π LinearMap.id hπ
  refine ⟨fun i => (LinearMap.proj i ∘ₗ s).compDer (KaehlerDifferential.D k R), hx, fun b => ?_⟩
  have h := LinearMap.congr_fun hs (KaehlerDifferential.D k R b)
  simp only [LinearMap.coe_comp, Function.comp_apply, LinearMap.id_coe, id_eq, π,
    Fintype.linearCombination_apply] at h
  simpa using h.symm

/-- A `k`-algebra generated by `r` elements over a field has Krull dimension
at most `r`. -/
theorem ringKrullDim_le_of_adjoin_eq_top {k : Type*} [Field k] [Algebra k R] {r : ℕ}
    {x : Fin r → R} (hx : Algebra.adjoin k (Set.range x) = ⊤) : ringKrullDim R ≤ r := by
  have hsurj : Function.Surjective (MvPolynomial.aeval (R := k) x) := by
    rw [← AlgHom.range_eq_top, ← Algebra.adjoin_range_eq_range_aeval, hx]
  refine (ringKrullDim_le_of_surjective _ hsurj).trans ?_
  rw [MvPolynomial.ringKrullDim_of_isNoetherianRing_of_finite, ringKrullDim_eq_zero_of_field,
    zero_add, Nat.card_fin]

end Existence

section Generated

variable {k R : Type*} [Field k] [CharZero k] [CommRing R] [Algebra k R]
  [Module.Projective R (Ω[R⁄k])] {r : ℕ} {x : Fin r → R}
  (hx : Algebra.adjoin k (Set.range x) = ⊤)
include hx

/-- **Deviation at most `2r`, right ideals.** If `R` is generated by `r`
elements over the field `k` of characteristic zero and `Ω_{R/k}` is projective,
the right ideals of `D_k(R)` have deviation at most `r + r`. -/
theorem devLE_right_of_adjoin_eq_top :
    Module.DevLE (algebra (k := k) (R := R))ᵐᵒᵖ (r + r) (algebra (k := k) (R := R)) := by
  classical
  have : Algebra.FiniteType k R := ⟨⟨Finset.univ.image x, by simpa using hx⟩⟩
  have : IsNoetherianRing R := Algebra.FiniteType.isNoetherianRing k R
  obtain ⟨E, hF⟩ := exists_isProjectiveFrame hx
  simpa using hF.devLE_right (ringKrullDim_le_of_adjoin_eq_top hx)

/-- **Deviation at most `2r`, left ideals.** -/
theorem devLE_left_of_adjoin_eq_top :
    Module.DevLE (algebra (k := k) (R := R)) (r + r) (algebra (k := k) (R := R)) := by
  classical
  have : Algebra.FiniteType k R := ⟨⟨Finset.univ.image x, by simpa using hx⟩⟩
  have : IsNoetherianRing R := Algebra.FiniteType.isNoetherianRing k R
  obtain ⟨E, hF⟩ := exists_isProjectiveFrame hx
  simpa using hF.devLE_left (ringKrullDim_le_of_adjoin_eq_top hx)

end Generated

end AlgebraicAnalysis.DifferentialOperators
