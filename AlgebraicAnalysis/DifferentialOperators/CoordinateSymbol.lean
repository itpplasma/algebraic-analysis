module
public import AlgebraicAnalysis.DifferentialOperators.OrderFiltration
public import AlgebraicAnalysis.Filtration.PolynomialSymbol
public import Mathlib.RingTheory.Adjoin.Basic

@[expose] public section

/-!
# The principal symbol of `D_k(R)` in coordinates

A **coordinate frame** of a commutative `k`-algebra `R`
(`DifferentialOperators.IsCoordinateFrame x D`) consists of elements
`x₁, …, x_r` generating `R` up to units (every `b ∈ R` satisfies `b s = r`
with `r, s ∈ k[x]` and `s` a unit) and derivations `∂₁, …, ∂_r` dual to them,
`∂ᵢ(xⱼ) = δᵢⱼ`. No commutation of the `∂ᵢ` is assumed. Polynomial rings and
all their localizations carry such frames. This file proves:

* **Commutator test** (`IsCoordinateFrame.mem_order_iff`): an operator has
  order at most `n` once its commutators with the `xᵢ` lie in `orderBelow n`.
  Since `[P, ab] = [P, a] b + a [P, b]`, the multiplications whose commutator
  with `P` lies in `orderBelow n` form a subalgebra, and
  `[P, b] s = [P, r] - b [P, s]` removes the unit denominators
  (`commutator_mem_of_exists_mul_eq`).
* **Euler identity modulo lower order** (any characteristic): for `P` of order
  at most `m`, `m P - ∑ᵢ [P, xᵢ] ∂ᵢ` has order at most `m - 1`
  (`IsCoordinateFrame.nsmul_sub_sum_mem_orderBelow`).
* **Filtered generation** (characteristic zero): every operator of order at
  most `n + 1` is `∑ᵢ Qᵢ ∂ᵢ` modulo order `n`, with `Qᵢ = [P, xᵢ]/(n+1)` of
  order at most `n` (`sub_sum_mem_order`). Hence the order filtration is
  generated in degree one by the `∂ᵢ` over `R` (`polynomialGenerators`),
  `D_k(R)` is generated by `R` and the `∂ᵢ` (`adjoin_eq_top`), and the symbol
  map `R[ξ₁, …, ξ_r] ↠ gr D_k(R)` is a surjective symbol presentation.
* Consequently, if `R` is Noetherian of Krull dimension at most `d`, then
  `D_k(R)` is right and left Noetherian and its right and left ideals have
  deviation at most `d + r` (`isNoetherian_right`, `isNoetherianRing`,
  `devLE_right`, `devLE_left`, `devLEOmega_right`, `devLEOmega_left`).

* **Principal symbol** (characteristic zero): the presentation is injective,
  so `gr D_k(R) ≅ R[ξ]` (`gradedSymbol`), and `D_k(R)` is a domain when `R` is
  (`isDomain`), by `RingFiltration.PolynomialGenerators.gradedSymbol` with the
  dual relations `[∂ᵢ, xⱼ] = δᵢⱼ` (`derivationElem_commutator`).

Simplicity is in `DifferentialOperators.CoordinateSimplicity`.

## References

The Euler-identity argument is AA-native. For the statement see
[EGA IV, 16.11.2] and [McConnell–Robson, 15.5].
-/

namespace AlgebraicAnalysis.DifferentialOperators

open RingFiltration

section Commutant

variable {k R : Type*} [CommRing k] [CommRing R] [Algebra k R]

theorem commutator_add_right (P : End (k := k) (R := R)) (a b : R) :
    commutator P (a + b) = commutator P a + commutator P b := by
  ext x
  simp only [commutator_apply, LinearMap.add_apply, add_mul, map_add]
  abel

theorem commutator_algebraMap (P : End (k := k) (R := R)) (c : k) :
    commutator P (algebraMap k R c) = 0 := by
  ext x
  simp [commutator_apply, ← Algebra.smul_def]

/-- **Commutator test on generators up to units.** Let `S` be a submodule of
operators stable under composition with multiplications on both sides.
Suppose every `b ∈ R` satisfies `b s = r` with `r, s` in the subalgebra
generated by the `xᵢ` and `s` a unit (for instance, `R` is a localization of
`k[x]`). If `[P, xᵢ] ∈ S` for all `i`, then `[P, b] ∈ S` for every `b ∈ R`:
the multiplications with commutator in `S` form a subalgebra, and
`[P, b] s = [P, r] - b [P, s]`. -/
theorem commutator_mem_of_exists_mul_eq {σ : Type*} {x : σ → R}
    (hx : ∀ b : R, ∃ r ∈ Algebra.adjoin k (Set.range x),
      ∃ s ∈ Algebra.adjoin k (Set.range x), IsUnit s ∧ b * s = r)
    (S : Submodule k (End (k := k) (R := R)))
    (hl : ∀ a Q, Q ∈ S → multiplication a * Q ∈ S)
    (hr : ∀ a Q, Q ∈ S → Q * multiplication a ∈ S)
    {P : End (k := k) (R := R)} (hP : ∀ i, commutator P (x i) ∈ S) (b : R) :
    commutator P b ∈ S := by
  let T : Subalgebra k R :=
    { carrier := {a | commutator P a ∈ S}
      mul_mem' := fun {a b} ha hb => by
        rw [Set.mem_ofPred_eq, commutator_mul_right]
        exact add_mem (hr _ _ ha) (hl _ _ hb)
      add_mem' := fun {a b} ha hb => by
        rw [Set.mem_ofPred_eq, commutator_add_right]
        exact add_mem ha hb
      algebraMap_mem' := fun c => by
        rw [Set.mem_ofPred_eq, commutator_algebraMap]
        exact zero_mem _ }
  have hT : Algebra.adjoin k (Set.range x) ≤ T :=
    Algebra.adjoin_le (by rintro _ ⟨i, rfl⟩; exact hP i)
  obtain ⟨r, hr', s, hs, ⟨u, rfl⟩, hbs⟩ := hx b
  have hmul : commutator P b * multiplication (u : R) ∈ S := by
    have h := commutator_mul_right P b u
    rw [hbs] at h
    rw [show commutator P b * multiplication (u : R) =
      commutator P r - multiplication b * commutator P u by rw [h]; abel]
    exact sub_mem (hT hr') (hl _ _ (hT hs))
  have h1 := hr ((u⁻¹ : Rˣ) : R) _ hmul
  rwa [mul_assoc, ← multiplication_mul, Units.mul_inv, show multiplication (k := k) (1 : R) = 1
    from LinearMap.ext fun _ => one_mul _, mul_one] at h1

/-- **Commutator test on generators.** Let `S` be a submodule of operators
stable under composition with multiplications on both sides. If `R` is
generated by the `xᵢ` and `[P, xᵢ] ∈ S` for all `i`, then `[P, a] ∈ S` for
every `a ∈ R`. -/
theorem commutator_mem_of_adjoin {σ : Type*} {x : σ → R}
    (hx : Algebra.adjoin k (Set.range x) = ⊤) (S : Submodule k (End (k := k) (R := R)))
    (hl : ∀ a Q, Q ∈ S → multiplication a * Q ∈ S)
    (hr : ∀ a Q, Q ∈ S → Q * multiplication a ∈ S)
    {P : End (k := k) (R := R)} (hP : ∀ i, commutator P (x i) ∈ S) (a : R) :
    commutator P a ∈ S :=
  commutator_mem_of_exists_mul_eq
    (fun b => ⟨b, hx ▸ Algebra.mem_top, 1, Subalgebra.one_mem _, isUnit_one, mul_one b⟩)
    S hl hr hP a

end Commutant

section Frame

variable {k R σ : Type*} [CommRing k] [CommRing R] [Algebra k R] [DecidableEq σ]

/-- A **coordinate frame** of the commutative `k`-algebra `R`: elements
`x₁, …, x_r` which generate `R` up to units (every `b ∈ R` satisfies `b s = r`
with `r, s ∈ k[x₁, …, x_r] ⊆ R` and `s` a unit), together with derivations
`∂₁, …, ∂_r` dual to them, `∂ᵢ(xⱼ) = δᵢⱼ`. No commutation of the `∂ᵢ` is
assumed. Examples: a polynomial ring with its partial derivatives, and any
localization of it (`LocalizedPolynomialOperators`). -/
structure IsCoordinateFrame (x : σ → R) (D : σ → Derivation k R R) : Prop where
  /-- Every element is a quotient of two elements of `k[x]`, by a unit. -/
  exists_mul_eq : ∀ b : R, ∃ r ∈ Algebra.adjoin k (Set.range x),
    ∃ s ∈ Algebra.adjoin k (Set.range x), IsUnit s ∧ b * s = r
  /-- The derivations are dual to the coordinates. -/
  dual : ∀ i j, D i (x j) = if i = j then 1 else 0

namespace IsCoordinateFrame

variable {x : σ → R} {D : σ → Derivation k R R}

/-- Algebra generators with dual derivations form a coordinate frame. -/
theorem of_adjoin_eq_top (hx : Algebra.adjoin k (Set.range x) = ⊤)
    (hdual : ∀ i j, D i (x j) = if i = j then 1 else 0) : IsCoordinateFrame x D where
  exists_mul_eq b := ⟨b, hx ▸ Algebra.mem_top, 1, Subalgebra.one_mem _, isUnit_one, mul_one b⟩
  dual := hdual

variable (hF : IsCoordinateFrame x D)
include hF

/-- **Commutator test.** An operator has order at most `n` iff its commutators
with the coordinates lie in `orderBelow n`. -/
theorem mem_order_iff {P : End (k := k) (R := R)} {n : ℕ} :
    P ∈ order n ↔ ∀ i, commutator P (x i) ∈ orderBelow n := by
  rw [mem_order_iff_commutator_mem_orderBelow]
  exact ⟨fun h i => h (x i), fun h => commutator_mem_of_exists_mul_eq hF.exists_mul_eq _
    (fun a _ hQ => multiplication_mul_mem_orderBelow a hQ)
    (fun a _ hQ => mul_multiplication_mem_orderBelow a hQ) h⟩

/-- An operator commuting with all coordinates is a multiplication. -/
theorem mem_order_zero_of_commutator_eq_zero {P : End (k := k) (R := R)}
    (hP : ∀ i, commutator P (x i) = 0) : P ∈ order 0 :=
  hF.mem_order_iff.mpr fun i => by rw [hP i]; exact zero_mem _

variable [Fintype σ]

/-- **Euler identity modulo lower order.** For an operator `P` of order at most
`m`, `m P - ∑ᵢ [P, xᵢ] ∂ᵢ` lies in `orderBelow m`. Holds in every
characteristic. -/
theorem nsmul_sub_sum_mem_orderBelow :
    ∀ m, ∀ P ∈ order (k := k) (R := R) m,
      m • P - ∑ i, commutator P (x i) * (D i).toLinearMap ∈ orderBelow m := by
  intro m
  induction m with
  | zero =>
      intro P hP
      rw [mem_order_zero_iff] at hP
      simp [hP]
  | succ n ih =>
      intro P hP
      rw [orderBelow_succ, hF.mem_order_iff]
      intro j
      have hmul : ∀ i, commutator P (x i) * multiplication (D i (x j)) =
          if i = j then commutator P (x j) else 0 := by
        intro i
        rw [hF.dual]
        split_ifs with hij
        · subst hij
          ext y
          simp
        · ext y
          simp
      have key : commutator ((n + 1) • P - ∑ i, commutator P (x i) * (D i).toLinearMap) (x j) =
          n • commutator P (x j) -
            ∑ i, commutator (commutator P (x j)) (x i) * (D i).toLinearMap := by
        rw [commutator_sub, commutator_nsmul, commutator_sum]
        simp only [commutator_mul, commutator_derivation, hmul, Finset.sum_add_distrib,
          Finset.sum_ite_eq', Finset.mem_univ, ite_true, commutator_commutator_comm P (x _) (x j)]
        rw [succ_nsmul]
        abel
      rw [key]
      exact ih _ ((mem_order_succ_iff P n).mp hP (x j))

end IsCoordinateFrame

end Frame

section Ring

variable (k R : Type*) [CommRing k] [CommRing R] [Algebra k R]

/-- Multiplication by elements of `R`, as an algebra map `R → D_k(R)`. -/
noncomputable def multiplicationAlgHom : R →ₐ[k] algebra (k := k) (R := R) :=
  (Algebra.lmul k R).codRestrict _ multiplication_mem_algebra

variable {k R}

@[simp] theorem coe_multiplicationAlgHom (a : R) :
    (multiplicationAlgHom k R a : End (k := k) (R := R)) = multiplication a := rfl

theorem multiplicationAlgHom_injective : Function.Injective (multiplicationAlgHom k R) :=
  fun a b h => by simpa using LinearMap.congr_fun (congrArg Subtype.val h) 1

/-- A derivation, as an element of `D_k(R)`. -/
def derivationElem (D : Derivation k R R) : algebra (k := k) (R := R) :=
  ⟨D.toLinearMap, ⟨1, derivation_mem_order_one D⟩⟩

@[simp] theorem coe_derivationElem (D : Derivation k R R) :
    (derivationElem D : End (k := k) (R := R)) = D.toLinearMap := rfl

/-- `D_k(R)` is nontrivial when `R` is. -/
instance [Nontrivial R] : Nontrivial (algebra (k := k) (R := R)) :=
  (multiplicationAlgHom_injective (k := k) (R := R)).nontrivial

end Ring

section Presentation

variable {k R σ : Type*} [Field k] [CharZero k] [CommRing R] [Algebra k R]
  [Fintype σ] [DecidableEq σ] {x : σ → R} {D : σ → Derivation k R R}

namespace IsCoordinateFrame

variable (hF : IsCoordinateFrame x D)
include hF

/-- **Filtered generation by the coordinate derivations** (characteristic
zero). If `P` has order at most `n + 1`, then
`P - ∑ᵢ ((n+1)⁻¹ [P, xᵢ]) ∂ᵢ` has order at most `n`. -/
theorem sub_sum_mem_order {n : ℕ} {P : End (k := k) (R := R)} (hP : P ∈ order (n + 1)) :
    P - ∑ i, (((n : k) + 1)⁻¹ • commutator P (x i)) * (D i).toLinearMap ∈ order n := by
  have h := (order n).smul_mem ((n : k) + 1)⁻¹ (hF.nsmul_sub_sum_mem_orderBelow (n + 1) P hP)
  have hne : ((n : k) + 1) ≠ 0 := by exact_mod_cast Nat.succ_ne_zero n
  convert h using 1
  rw [smul_sub, Finset.smul_sum, ← Nat.cast_smul_eq_nsmul k, smul_smul, Nat.cast_add,
    Nat.cast_one, inv_mul_cancel₀ hne, one_smul]
  simp only [smul_mul_assoc]

/-- **The order filtration of `D_k(R)` is generated in degree one** by the
coordinate derivations over `R`: the hypotheses of a polynomial presentation
`R[ξ_σ] ↠ gr D_k(R)`, `ξᵢ ↦ [∂ᵢ]`. -/
theorem polynomialGenerators :
    (orderFiltration (k := k) (R := R)).PolynomialGenerators (multiplicationAlgHom k R)
      (fun i => derivationElem (D i)) where
  grCommutative := orderFiltration_grCommutative
  map_mem a := multiplication_mem_order_zero a
  exists_map_eq P hP := ⟨P.1 1, Subtype.ext ((mem_order_zero_iff_eq_multiplication _).mp hP).symm⟩
  gen_mem i := derivation_mem_order_one (D i)
  exists_sum_mul n P hP := by
    refine ⟨fun i => ⟨((n : k) + 1)⁻¹ • commutator P.1 (x i), n,
      (order n).smul_mem _ ((mem_order_succ_iff P.1 n).mp hP (x i))⟩,
      fun i => (order n).smul_mem _ ((mem_order_succ_iff P.1 n).mp hP (x i)), ?_⟩
    rw [mem_orderFiltration_F]
    simpa using hF.sub_sum_mem_order hP

/-- **`D_k(R)` is generated by `R` and the coordinate derivations.** -/
theorem adjoin_eq_top :
    Algebra.adjoin k (Set.range (multiplicationAlgHom k R) ∪
      Set.range fun i => derivationElem (D i)) = ⊤ :=
  hF.polynomialGenerators.adjoin_eq_top

/-- The symbol presentation `R[ξ_σ] ↠ gr D_k(R)`, `a ξ^α ↦ [a ∂^α]`. -/
noncomputable def symbolPresentation :
    (orderFiltration (k := k) (R := R)).SymbolPresentation (polynomialGrading σ k R) :=
  hF.polynomialGenerators.presentation

omit [CharZero k] [Fintype σ] in
/-- `[∂ᵢ, xⱼ] = δᵢⱼ` in `D_k(R)`. -/
theorem derivationElem_commutator (i j : σ) :
    derivationElem (D i) * multiplicationAlgHom k R (x j) -
        multiplicationAlgHom k R (x j) * derivationElem (D i) = if i = j then 1 else 0 := by
  apply Subtype.ext
  change commutator (D i).toLinearMap (x j) = _
  rw [commutator_derivation, hF.dual]
  split_ifs <;> ext <;> simp

/-- **`gr D_k(R) ≅ R[ξ₁, …, ξ_r]`** (characteristic zero): the symbol
presentation is injective, since commutation with `xⱼ` acts on symbols as
`∂/∂ξⱼ` (`RingFiltration.PolynomialGenerators.gradedSymbol`). -/
noncomputable def gradedSymbol :
    (orderFiltration (k := k) (R := R)).GradedSymbol (polynomialGrading σ k R) :=
  hF.polynomialGenerators.gradedSymbol hF.derivationElem_commutator
    multiplicationAlgHom_injective

/-- **`D_k(R)` is a domain** if `R` is a domain with a coordinate frame
(characteristic zero). -/
theorem isDomain [IsDomain R] : IsDomain (algebra (k := k) (R := R)) :=
  hF.polynomialGenerators.isDomain hF.derivationElem_commutator multiplicationAlgHom_injective

variable [IsNoetherianRing R]

/-- `D_k(R)` is right Noetherian. -/
theorem isNoetherian_right :
    IsNoetherian (algebra (k := k) (R := R))ᵐᵒᵖ (algebra (k := k) (R := R)) :=
  hF.polynomialGenerators.isNoetherian_right

/-- `D_k(R)` is left Noetherian. -/
theorem isNoetherianRing : IsNoetherianRing (algebra (k := k) (R := R)) :=
  hF.polynomialGenerators.isNoetherianRing

/-- If `dim R ≤ d`, the right ideals of `D_k(R)` have deviation at most `d + r`. -/
theorem devLE_right {d : ℕ} (hR : ringKrullDim R ≤ d) :
    Module.DevLE (algebra (k := k) (R := R))ᵐᵒᵖ (d + Nat.card σ) (algebra (k := k) (R := R)) :=
  hF.polynomialGenerators.devLE_right hR

/-- If `dim R ≤ d`, the left ideals of `D_k(R)` have deviation at most `d + r`. -/
theorem devLE_left {d : ℕ} (hR : ringKrullDim R ≤ d) :
    Module.DevLE (algebra (k := k) (R := R)) (d + Nat.card σ) (algebra (k := k) (R := R)) :=
  hF.polynomialGenerators.devLE_left hR

/-- If `R` has finite Krull dimension, the right ideals of `D_k(R)` have
deviation at most omega. -/
theorem devLEOmega_right {d : ℕ} (hR : ringKrullDim R ≤ d) :
    Module.DevLEOmega (algebra (k := k) (R := R))ᵐᵒᵖ (algebra (k := k) (R := R)) :=
  hF.polynomialGenerators.devLEOmega_right hR

/-- If `R` has finite Krull dimension, the left ideals of `D_k(R)` have
deviation at most omega. -/
theorem devLEOmega_left {d : ℕ} (hR : ringKrullDim R ≤ d) :
    Module.DevLEOmega (algebra (k := k) (R := R)) (algebra (k := k) (R := R)) :=
  hF.polynomialGenerators.devLEOmega_left hR

end IsCoordinateFrame

end Presentation

end AlgebraicAnalysis.DifferentialOperators
