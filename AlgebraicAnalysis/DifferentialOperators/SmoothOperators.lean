module
public import AlgebraicAnalysis.DifferentialOperators.ProjectiveFrame
public import AlgebraicAnalysis.DifferentialOperators.Domain
public import AlgebraicAnalysis.DifferentialOperators.SmoothSimplicity

@[expose] public section

/-!
# Differential operators on a smooth affine variety

Let `k` be a field of characteristic zero and `A` a smooth `k`-algebra
(`Algebra.Smooth k A`; finitely presented with projective `Ω_{A/k}`), and let
`D = D_k(A)` be the ring of finite-order `k`-linear differential operators
(`DifferentialOperators.algebra`).

## Main results

* `isNoetherian_right`, `isNoetherianRing`: `D` is right and left Noetherian.
* `devLE_right`, `devLE_left`: if `A` is generated by `r` elements, the right
  and left ideals of `D` have deviation at most `2r`; `devLEOmega_right`,
  `devLEOmega_left`: deviation at most omega.
* `adjoin_eq_top`: `D` is generated by the multiplications and finitely many
  derivations.

If moreover `A` is a domain:

* `isDomain`: `D` is a domain.
* `isSimpleRing`: `D` is simple.
* `infinite_center`: `D` has infinite centre.

## Proof outline

* Noetherian and deviation: generators `x₁, …, x_r` of `A` extend to a
  projective frame (`exists_isProjectiveFrame`), whose Euler identity presents
  `gr D` as a quotient of `A[ξ₁, …, ξ_r]` (`IsProjectiveFrame.polynomialGenerators`);
  `dim A ≤ r` (`ringKrullDim_le_of_adjoin_eq_top`).
* Domain: polarization of the principal symbol (`DifferentialOperators.isDomain`),
  valid for every domain.
* Simplicity: a smooth domain has no nonzero proper ideal stable under all
  derivations (`eq_top_of_derivation_mem_of_smooth`), by quasi-finiteness over
  a polynomial ring on standard smooth opens; then
  `isSimpleRing_of_derivation`.

No axioms beyond Lean's standard ones are used. Compare [McConnell–Robson,
*Noncommutative Noetherian Rings*, 15.1.20, 15.3.8, 15.5.5] and
[EGA IV, 16.11.2].
-/

namespace AlgebraicAnalysis.DifferentialOperators.SmoothOperators

universe u v

variable (k : Type u) (A : Type v) [Field k] [CharZero k] [CommRing A] [Algebra k A]
  [Algebra.Smooth k A]

/-- The ring `D_k(A)` of finite-order `k`-linear differential operators on `A`. -/
abbrev DiffOp : Type v := algebra (k := k) (R := A)

omit [CharZero k] in
/-- `A` has a projective frame indexed by a finite set of algebra generators. -/
theorem exists_isProjectiveFrame' :
    ∃ r, ∃ x : Fin r → A, Algebra.adjoin k (Set.range x) = ⊤ ∧
      ∃ E : Fin r → Derivation k A A, IsProjectiveFrame x E := by
  obtain ⟨r, x, hx⟩ : ∃ r, ∃ x : Fin r → A, Algebra.adjoin k (Set.range x) = ⊤ := by
    obtain ⟨s, hs⟩ := (inferInstance : Algebra.FiniteType k A).out
    refine ⟨s.card, fun i => (s.equivFin.symm i : A), ?_⟩
    rw [← hs]
    congr 1
    ext a
    exact ⟨fun ⟨i, hi⟩ => hi ▸ (s.equivFin.symm i).2, fun ha => ⟨s.equivFin ⟨a, ha⟩, by simp⟩⟩
  exact ⟨r, x, hx, exists_isProjectiveFrame hx⟩

/-- **`D_k(A)` is generated by `A` and finitely many derivations.** -/
theorem adjoin_eq_top : ∃ r, ∃ E : Fin r → Derivation k A A,
    Algebra.adjoin k (Set.range (multiplicationAlgHom k A) ∪
      Set.range fun i => derivationElem (E i)) = ⊤ := by
  obtain ⟨r, x, -, E, hF⟩ := exists_isProjectiveFrame' k A
  exact ⟨r, E, hF.adjoin_eq_top_diffOp⟩

/-- **`D_k(A)` is right Noetherian.** -/
theorem isNoetherian_right : IsNoetherian (DiffOp k A)ᵐᵒᵖ (DiffOp k A) := by
  have := Algebra.FiniteType.isNoetherianRing k A
  obtain ⟨r, x, -, E, hF⟩ := exists_isProjectiveFrame' k A
  exact hF.isNoetherian_right

/-- **`D_k(A)` is left Noetherian.** -/
theorem isNoetherianRing : IsNoetherianRing (DiffOp k A) := by
  have := Algebra.FiniteType.isNoetherianRing k A
  obtain ⟨r, x, -, E, hF⟩ := exists_isProjectiveFrame' k A
  exact hF.isNoetherianRing

variable {k A} in
/-- **Deviation at most `2r`, right ideals**, if `A` is generated by `r` elements. -/
theorem devLE_right {r : ℕ} {x : Fin r → A} (hx : Algebra.adjoin k (Set.range x) = ⊤) :
    Module.DevLE (DiffOp k A)ᵐᵒᵖ (r + r) (DiffOp k A) :=
  devLE_right_of_adjoin_eq_top hx

variable {k A} in
/-- **Deviation at most `2r`, left ideals**, if `A` is generated by `r` elements. -/
theorem devLE_left {r : ℕ} {x : Fin r → A} (hx : Algebra.adjoin k (Set.range x) = ⊤) :
    Module.DevLE (DiffOp k A) (r + r) (DiffOp k A) :=
  devLE_left_of_adjoin_eq_top hx

/-- The right ideals of `D_k(A)` have deviation at most omega. -/
theorem devLEOmega_right : Module.DevLEOmega (DiffOp k A)ᵐᵒᵖ (DiffOp k A) := by
  have := Algebra.FiniteType.isNoetherianRing k A
  obtain ⟨r, x, hx, E, hF⟩ := exists_isProjectiveFrame' k A
  exact hF.devLEOmega_right (ringKrullDim_le_of_adjoin_eq_top hx)

/-- The left ideals of `D_k(A)` have deviation at most omega. -/
theorem devLEOmega_left : Module.DevLEOmega (DiffOp k A) (DiffOp k A) := by
  have := Algebra.FiniteType.isNoetherianRing k A
  obtain ⟨r, x, hx, E, hF⟩ := exists_isProjectiveFrame' k A
  exact hF.devLEOmega_left (ringKrullDim_le_of_adjoin_eq_top hx)

variable [IsDomain A]

omit [Algebra.Smooth k A] in
/-- **`D_k(A)` is a domain** for a smooth domain `A` (smoothness is not needed,
see `DifferentialOperators.isDomain`). -/
theorem isDomain : IsDomain (DiffOp k A) :=
  DifferentialOperators.isDomain

/-- **`D_k(A)` is simple** for a smooth domain `A`. -/
theorem isSimpleRing : IsSimpleRing (DiffOp k A) :=
  isSimpleRing_of_smooth

omit [Algebra.Smooth k A] in
/-- **`D_k(A)` has infinite centre**: it contains the scalars. -/
theorem infinite_center : Infinite (Subring.center (DiffOp k A)) :=
  have : Infinite k := CharZero.infinite k
  DifferentialOperators.infinite_center k A

end AlgebraicAnalysis.DifferentialOperators.SmoothOperators
