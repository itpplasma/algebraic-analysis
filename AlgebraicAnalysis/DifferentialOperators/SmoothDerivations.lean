module
public import Mathlib.RingTheory.Smooth.Basic
public import Mathlib.LinearAlgebra.Dual.Lemmas

@[expose] public section

/-!
# Derivations of a smooth algebra form a finitely generated projective module

For a commutative `k`-algebra `A`, `Der_k(A) ≅ Hom_A(Ω_{A/k}, A)`
(`KaehlerDifferential.linearMapEquivDerivation`). If `Ω_{A/k}` is finitely
generated and projective, so is its dual, hence so is `Der_k(A)`
(`finite_derivation`, `projective_derivation`). This holds for smooth
algebras (`Algebra.Smooth`): `Ω_{A/k}` is projective by formal smoothness and
finitely generated by finite presentation (`finite_derivation_of_smooth`,
`projective_derivation_of_smooth`).

This is the module-theoretic input for differential operators on smooth
algebras: locally on `Spec A` the module `Der_k(A)` is free with a basis dual
to étale coordinates. AA-native; the facts are standard
([Stacks, 00TH, 00TI]).
-/

namespace AlgebraicAnalysis.DifferentialOperators

variable (k A : Type*) [CommRing k] [CommRing A] [Algebra k A]

/-- `Der_k(A)` is finitely generated when `Ω_{A/k}` is finitely generated and
projective. -/
theorem finite_derivation [Module.Finite A Ω[A⁄k]] [Module.Projective A Ω[A⁄k]] :
    Module.Finite A (Derivation k A A) :=
  Module.Finite.equiv (KaehlerDifferential.linearMapEquivDerivation k A)

/-- `Der_k(A)` is projective when `Ω_{A/k}` is finitely generated and projective. -/
theorem projective_derivation [Module.Finite A Ω[A⁄k]] [Module.Projective A Ω[A⁄k]] :
    Module.Projective A (Derivation k A A) :=
  Module.Projective.of_equiv (KaehlerDifferential.linearMapEquivDerivation k A)

/-- **The derivations of a smooth algebra form a finitely generated module.** -/
theorem finite_derivation_of_smooth [Algebra.Smooth k A] : Module.Finite A (Derivation k A A) :=
  finite_derivation k A

/-- **The derivations of a smooth algebra form a projective module.** -/
theorem projective_derivation_of_smooth [Algebra.Smooth k A] :
    Module.Projective A (Derivation k A A) :=
  projective_derivation k A

end AlgebraicAnalysis.DifferentialOperators
