module
public import AlgebraicAnalysis.DifferentialOperators.CoordinateSymbol
public import AlgebraicAnalysis.Weyl.Simplicity
public import AlgebraicAnalysis.Weyl.Domain
public import AlgebraicAnalysis.Weyl.Universal
public import AlgebraicAnalysis.RingTheory.InfiniteCenter
public import Mathlib.Algebra.MvPolynomial.PDeriv
public import Mathlib.Algebra.CharZero.Infinite
public import Mathlib.RingTheory.Derivation.Lie

@[expose] public section

/-!
# Differential operators on a polynomial ring

Let `k` be a field and `R = k[x₁, …, xₙ]`. This file applies the coordinate
symbol presentation (`DifferentialOperators.CoordinateSymbol`) to the
coordinates `xᵢ` and the partial derivatives `∂ᵢ = ∂/∂xᵢ`, and identifies the
ring `D_k(R)` of all finite-order `k`-linear differential operators with the
Weyl algebra `A_n(k)` in characteristic zero.

## Main results

For a field `k` of characteristic zero, `D = D_k(k[x₁, …, xₙ])`:

* `PolynomialOperators.isNoetherian_right`, `isNoetherianRing`: `D` is right
  and left Noetherian.
* `PolynomialOperators.devLE_right`, `devLE_left`: the right and left ideals
  of `D` have deviation at most `2n`; `devLEOmega_right`, `devLEOmega_left`.
* `PolynomialOperators.adjoin_eq_top`: `D` is generated by the
  multiplications by `xᵢ` and the `∂ᵢ`.
* `PolynomialOperators.weylEquiv : WeylAlg k n ≃ₐ[k] D`, `xᵢ ↦ xᵢ`,
  `∂ᵢ ↦ ∂/∂xᵢ`. Surjectivity is the generation theorem; injectivity holds
  because `A_n(k)` is simple (`Weyl.Simplicity.isSimpleRing_weylAlg`).
* `PolynomialOperators.isSimpleRing`, `isDomain`, `infinite_center`.

The Noetherian and deviation statements are proved from the order filtration
of `D` itself, not transported from the Weyl algebra.
-/

namespace AlgebraicAnalysis.DifferentialOperators.PolynomialOperators

open MvPolynomial AlgebraicAnalysis.Weyl

variable (k : Type*) [Field k] (n : ℕ)

/-- The ring `D_k(k[x₁, …, xₙ])` of finite-order `k`-linear differential
operators on the polynomial ring. -/
abbrev DiffOp : Type _ := algebra (k := k) (R := MvPolynomial (Fin n) k)

variable {k n}

/-- The partial derivatives are dual to the coordinates. -/
theorem pderiv_X_eq_ite (i j : Fin n) :
    pderiv i (X j : MvPolynomial (Fin n) k) = if i = j then 1 else 0 := by
  rw [pderiv_X, Pi.single_apply]
  simp only [eq_comm]

/-- Partial derivatives commute. -/
theorem pderiv_mul_pderiv_comm (i j : Fin n) :
    (pderiv (R := k) i).toLinearMap * (pderiv (R := k) j).toLinearMap =
      (pderiv (R := k) j).toLinearMap * (pderiv (R := k) i).toLinearMap := by
  have h : ⁅(pderiv i : Derivation k (MvPolynomial (Fin n) k) (MvPolynomial (Fin n) k)),
      pderiv (R := k) j⁆ = 0 := by
    apply MvPolynomial.derivation_ext
    intro l
    simp only [Derivation.commutator_apply, Derivation.zero_apply, pderiv_X_eq_ite]
    split_ifs <;> simp
  refine LinearMap.ext fun f => ?_
  have hf := Derivation.congr_fun h f
  simp only [Derivation.commutator_apply, Derivation.zero_apply] at hf
  exact sub_eq_zero.mp hf

theorem adjoin_range_X' :
    Algebra.adjoin k (Set.range (X : Fin n → MvPolynomial (Fin n) k)) = ⊤ :=
  MvPolynomial.adjoin_range_X

/-- The polynomial ring `k[x₁, …, xₙ]` has Krull dimension at most `n`. -/
theorem ringKrullDim_le : ringKrullDim (MvPolynomial (Fin n) k) ≤ n := by
  rw [MvPolynomial.ringKrullDim_of_isNoetherianRing_of_finite, ringKrullDim_eq_zero_of_field,
    zero_add, Nat.card_fin]

variable [CharZero k]

/-- `D_k(k[x])` is generated by the multiplications by the coordinates and the
partial derivatives (with `R = k[x]` itself among the generators). -/
theorem adjoin_eq_top :
    Algebra.adjoin k (Set.range (multiplicationAlgHom k (MvPolynomial (Fin n) k)) ∪
      Set.range fun i : Fin n => derivationElem (pderiv i)) = ⊤ :=
  DifferentialOperators.adjoin_eq_top adjoin_range_X' pderiv_X_eq_ite

/-- `D_k(k[x₁, …, xₙ])` is right Noetherian. -/
theorem isNoetherian_right : IsNoetherian (DiffOp k n)ᵐᵒᵖ (DiffOp k n) :=
  DifferentialOperators.isNoetherian_right adjoin_range_X' pderiv_X_eq_ite

/-- `D_k(k[x₁, …, xₙ])` is left Noetherian. -/
theorem isNoetherianRing : IsNoetherianRing (DiffOp k n) :=
  DifferentialOperators.isNoetherianRing adjoin_range_X' pderiv_X_eq_ite

/-- The right ideals of `D_k(k[x₁, …, xₙ])` have deviation at most `2n`. -/
theorem devLE_right : Module.DevLE (DiffOp k n)ᵐᵒᵖ (n + n) (DiffOp k n) := by
  simpa using DifferentialOperators.devLE_right adjoin_range_X' pderiv_X_eq_ite ringKrullDim_le

/-- The left ideals of `D_k(k[x₁, …, xₙ])` have deviation at most `2n`. -/
theorem devLE_left : Module.DevLE (DiffOp k n) (n + n) (DiffOp k n) := by
  simpa using DifferentialOperators.devLE_left adjoin_range_X' pderiv_X_eq_ite ringKrullDim_le

/-- The right ideals of `D_k(k[x₁, …, xₙ])` have deviation at most omega. -/
theorem devLEOmega_right : Module.DevLEOmega (DiffOp k n)ᵐᵒᵖ (DiffOp k n) :=
  DifferentialOperators.devLEOmega_right adjoin_range_X' pderiv_X_eq_ite ringKrullDim_le

/-- The left ideals of `D_k(k[x₁, …, xₙ])` have deviation at most omega. -/
theorem devLEOmega_left : Module.DevLEOmega (DiffOp k n) (DiffOp k n) :=
  DifferentialOperators.devLEOmega_left adjoin_range_X' pderiv_X_eq_ite ringKrullDim_le

/-! ## The Weyl algebra -/

variable (k n) in
/-- The images of the Weyl generators: `inl i ↦ xᵢ`, `inr i ↦ ∂ᵢ`. -/
noncomputable def weylGenerator : PhaseVar n → DiffOp k n
  | .inl i => multiplicationAlgHom k _ (X i)
  | .inr i => derivationElem (pderiv i)

omit [CharZero k] in
/-- The Weyl relations `[∂ᵢ, xⱼ] = δᵢⱼ`, `[xᵢ, xⱼ] = [∂ᵢ, ∂ⱼ] = 0`, in the sign
convention of `Matrix.J`. -/
theorem weylGenerator_commutator (i j : PhaseVar n) :
    ringCommutator (weylGenerator k n i) (weylGenerator k n j) =
      algebraMap k (DiffOp k n) (Matrix.J (Fin n) k i j) := by
  apply Subtype.ext
  rcases i with i | i <;> rcases j with j | j
  · refine LinearMap.ext fun f => ?_
    simp [weylGenerator, Matrix.J, mul_left_comm]
  · refine LinearMap.ext fun f => ?_
    simp [weylGenerator, Matrix.J, Matrix.one_apply, -pderiv_X, pderiv_X_eq_ite, eq_comm,
      Derivation.leibniz]
    split_ifs <;> simp
  · refine LinearMap.ext fun f => ?_
    simp [weylGenerator, Matrix.J, Matrix.one_apply, -pderiv_X, pderiv_X_eq_ite,
      Derivation.leibniz]
    split_ifs <;> simp
  · simp only [weylGenerator, ringCommutator_apply, Subalgebra.coe_sub, Subalgebra.coe_mul,
      coe_derivationElem, pderiv_mul_pderiv_comm i j, sub_self, Matrix.J]
    simp

variable (k n) in
/-- The algebra map `A_n(k) → D_k(k[x₁, …, xₙ])`, `xᵢ ↦ xᵢ`, `∂ᵢ ↦ ∂/∂xᵢ`. -/
noncomputable def fromWeyl : WeylAlg k n →ₐ[k] DiffOp k n :=
  Universal.freeWeylLift _ (weylGenerator k n) weylGenerator_commutator

omit [CharZero k] in
@[simp] theorem fromWeyl_generator (i : PhaseVar n) :
    fromWeyl k n (generator k n i) = weylGenerator k n i :=
  Universal.freeWeylLift_generator _ _ _ i

theorem fromWeyl_surjective : Function.Surjective (fromWeyl k n) := by
  rw [← AlgHom.range_eq_top, eq_top_iff, ← adjoin_eq_top, Algebra.adjoin_le_iff]
  rintro _ (⟨a, rfl⟩ | ⟨i, rfl⟩)
  · have hX : Algebra.adjoin k (Set.range (X : Fin n → MvPolynomial (Fin n) k)) ≤
        (fromWeyl k n).range.comap (multiplicationAlgHom k _) := by
      rw [Algebra.adjoin_le_iff]
      rintro _ ⟨i, rfl⟩
      exact ⟨generator k n (.inl i), fromWeyl_generator _⟩
    rw [adjoin_range_X'] at hX
    exact hX (Algebra.mem_top (x := a))
  · exact ⟨generator k n (.inr i), fromWeyl_generator _⟩

theorem fromWeyl_injective : Function.Injective (fromWeyl k n) := by
  have := Simplicity.isSimpleRing_weylAlg k n
  exact (fromWeyl k n).toRingHom.injective

variable (k n) in
/-- **`D_k(k[x₁, …, xₙ]) ≅ A_n(k)`** in characteristic zero. -/
noncomputable def weylEquiv : WeylAlg k n ≃ₐ[k] DiffOp k n :=
  AlgEquiv.ofBijective (fromWeyl k n) ⟨fromWeyl_injective, fromWeyl_surjective⟩

@[simp] theorem weylEquiv_apply (a : WeylAlg k n) : weylEquiv k n a = fromWeyl k n a := rfl

/-- **`D_k(k[x₁, …, xₙ])` is simple** in characteristic zero. -/
instance isSimpleRing : IsSimpleRing (DiffOp k n) :=
  IsSimpleRing.of_ringEquiv (weylEquiv k n).toRingEquiv (Simplicity.isSimpleRing_weylAlg k n)

/-- **`D_k(k[x₁, …, xₙ])` is a domain** in characteristic zero. -/
instance isDomain : IsDomain (DiffOp k n) :=
  MulEquiv.isDomain (WeylAlg k n) (weylEquiv k n).symm.toRingEquiv.toMulEquiv

/-- **`D_k(k[x₁, …, xₙ])` has an infinite centre** in characteristic zero: it
contains the scalars `k`. -/
theorem infinite_center : Infinite (Subring.center (DiffOp k n)) :=
  have : Infinite k := CharZero.infinite k
  infinite_subring_center k (DiffOp k n)

end AlgebraicAnalysis.DifferentialOperators.PolynomialOperators
