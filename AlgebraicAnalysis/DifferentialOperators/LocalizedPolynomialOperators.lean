module
public import AlgebraicAnalysis.DifferentialOperators.CoordinateSimplicity
public import AlgebraicAnalysis.DifferentialOperators.PolynomialOperators
public import AlgebraicAnalysis.DifferentialOperators.LocalizedPolynomialDerivations
public import Mathlib.RingTheory.KrullDimension.Polynomial
public import Mathlib.RingTheory.Localization.Submodule

@[expose] public section

/-!
# Differential operators on a localized polynomial ring

Let `k` be a field, `S` a submonoid of `k[x₁, …, xₙ]` and `B = S⁻¹k[x₁, …, xₙ]`
(any `IsLocalization S B`). Examples: `k[x][f⁻¹]` (powers of `f`), the Laurent
polynomials, and the rational function field `k(x₁, …, xₙ)` (all nonzero
polynomials). The images of the coordinates `xᵢ` and the extended partial
derivatives `∂ᵢ` (`LocalizedPolynomialDerivations.localizedPderiv`) form a
coordinate frame of `B` (`isCoordinateFrame`), so the general coordinate
theory applies to `D = D_k(B)`.

## Main results

In characteristic zero:

* `isNoetherian_right`, `isNoetherianRing`: `D` is right and left Noetherian.
* `devLE_right`, `devLE_left`: right and left ideals of `D` have deviation at
  most `2n` (since `dim B ≤ n`, `ringKrullDim_le`); `devLEOmega_right`,
  `devLEOmega_left`.
* `adjoin_eq_top`: `D` is generated by `B` and the `∂ᵢ`.

If moreover `0 ∉ S` (`S ≤ nonZeroDivisors`):

* `eq_top_of_pderiv_mem`: the only nonzero ideal of `B` stable under all `∂ᵢ`
  is `B` (lower the total degree of a numerator with the `∂ᵢ`).
* `isSimpleRing`: `D` is simple.
* `isDomain`: `D` is a domain (`gr D ≅ B[ξ]`).
* `infinite_center`: `D` has infinite centre.

Also `AlgebraicAnalysis.ringKrullDim_le_of_isLocalization`: localization does
not increase Krull dimension.

The arguments are AA-native; for the statements see [McConnell–Robson,
*Noncommutative Noetherian Rings*, 15.1.20, 15.3.8].
-/

namespace AlgebraicAnalysis

/-- **Localization does not increase Krull dimension**: primes of `S⁻¹A`
embed order-preservingly into primes of `A` by contraction. -/
theorem ringKrullDim_le_of_isLocalization {A B : Type*} [CommRing A] [CommRing B] [Algebra A B]
    (S : Submonoid A) [IsLocalization S B] : ringKrullDim B ≤ ringKrullDim A :=
  Order.krullDim_le_of_strictMono
    (fun p => ⟨p.asIdeal.under A, Ideal.IsPrime.under A p.asIdeal⟩)
    fun _ _ h => (IsLocalization.orderEmbedding S B).strictMono h

end AlgebraicAnalysis

namespace AlgebraicAnalysis.DifferentialOperators.LocalizedPolynomialOperators

open MvPolynomial LocalizedPolynomialDerivations

/-! ## Two facts about partial derivatives -/

section Pderiv

variable {k σ : Type*} [Field k]

/-- A partial derivative lowers the total degree by at least one. -/
theorem totalDegree_pderiv_le (p : MvPolynomial σ k) (i : σ) :
    (pderiv i p).totalDegree ≤ p.totalDegree - 1 := by
  refine Finset.sup_le fun m hm => ?_
  rw [mem_support_iff, coeff_pderiv] at hm
  have hc := left_ne_zero_of_mul hm
  have hle := le_totalDegree (mem_support_iff.mpr hc)
  rw [Finsupp.sum_add_index' (fun _ => rfl) (fun _ _ _ => rfl),
    Finsupp.sum_single_index rfl] at hle
  omega

variable [CharZero k]

/-- In characteristic zero, a polynomial with all partial derivatives zero is
constant. -/
theorem eq_C_of_pderiv_eq_zero {p : MvPolynomial σ k} (h : ∀ i, pderiv i p = 0) :
    p = C (p.coeff 0) := by
  classical
  ext m
  by_cases hm : m = 0
  · subst hm
    simp
  obtain ⟨i, hi⟩ : ∃ i, m i ≠ 0 := by
    by_contra hcon
    push Not at hcon
    exact hm (Finsupp.ext hcon)
  rw [coeff_C]
  simp only [Ne.symm hm, ↓reduceIte]
  have hm' : m - Finsupp.single i 1 + Finsupp.single i 1 = m := by
    ext l
    simp only [Finsupp.coe_add, Finsupp.coe_tsub, Pi.add_apply, Pi.sub_apply,
      Finsupp.single_apply]
    split_ifs with hl
    · subst hl
      omega
    · simp
  have hcoeff := coeff_pderiv (i := i) p (m - Finsupp.single i 1)
  rw [h i, hm'] at hcoeff
  have hne : (((m - Finsupp.single i 1 : σ →₀ ℕ) i : ℕ) : k) + 1 ≠ 0 := Nat.cast_add_one_ne_zero _
  rcases mul_eq_zero.mp (hcoeff.symm.trans (by simp)) with h0 | h0
  · exact h0
  · exact absurd h0 hne

end Pderiv

/-! ## The coordinate frame of a localized polynomial ring -/

universe u

variable {k : Type u} [Field k] {n : ℕ} (S : Submonoid (MvPolynomial (Fin n) k))
  (B : Type u) [CommRing B] [Algebra (MvPolynomial (Fin n) k) B] [Algebra k B]
  [IsScalarTower k (MvPolynomial (Fin n) k) B] [IsLocalization S B]

variable (k) in
/-- The ring `D_k(B)` of finite-order `k`-linear differential operators on
`B = S⁻¹k[x₁, …, xₙ]`. -/
abbrev DiffOp : Type u := algebra (k := k) (R := B)

/-- The image of the coordinate `xᵢ` in `B`. -/
noncomputable abbrev coordinate (i : Fin n) : B :=
  algebraMap (MvPolynomial (Fin n) k) B (X i)

/-- Every polynomial lies in the subalgebra generated by the coordinates. -/
theorem algebraMap_mem_adjoin (p : MvPolynomial (Fin n) k) :
    algebraMap (MvPolynomial (Fin n) k) B p ∈
      Algebra.adjoin k (Set.range (coordinate (k := k) (n := n) B)) := by
  have h := Algebra.adjoin_image k (IsScalarTower.toAlgHom k (MvPolynomial (Fin n) k) B)
    (Set.range X)
  rw [← Set.range_comp] at h
  change _ ∈ Algebra.adjoin k (Set.range (IsScalarTower.toAlgHom k _ B ∘ X))
  rw [h, MvPolynomial.adjoin_range_X]
  exact ⟨p, Algebra.mem_top, rfl⟩

include S

/-- **The coordinates and the extended partial derivatives form a coordinate
frame of `B = S⁻¹k[x]`**: every element is `r/s` with `r, s` polynomials and
`s` a unit, and `∂ᵢ(xⱼ) = δᵢⱼ`. -/
theorem isCoordinateFrame :
    IsCoordinateFrame (coordinate (k := k) (n := n) B) (localizedPderiv S B) where
  exists_mul_eq b := by
    obtain ⟨⟨r, s⟩, hrs⟩ := IsLocalization.surj S b
    exact ⟨_, algebraMap_mem_adjoin B r, _, algebraMap_mem_adjoin B s,
      IsLocalization.map_units B s, hrs⟩
  dual := localizedPderiv_apply_algebraMap_X S B

omit [Algebra k B] [IsScalarTower k (MvPolynomial (Fin n) k) B] in
/-- `B` is Noetherian. -/
theorem isNoetherianRing_base : IsNoetherianRing B :=
  IsLocalization.isNoetherianRing S B inferInstance

omit [Algebra k B] [IsScalarTower k (MvPolynomial (Fin n) k) B] in
/-- `dim S⁻¹k[x₁, …, xₙ] ≤ n`. -/
theorem ringKrullDim_le : ringKrullDim B ≤ n :=
  (ringKrullDim_le_of_isLocalization S).trans PolynomialOperators.ringKrullDim_le

variable [CharZero k]

/-- `D_k(B)` is generated by `B` and the `∂ᵢ`. -/
theorem adjoin_eq_top :
    Algebra.adjoin k (Set.range (multiplicationAlgHom k B) ∪
      Set.range fun i => derivationElem (localizedPderiv S B i)) = ⊤ :=
  (isCoordinateFrame S B).adjoin_eq_top

/-- `D_k(S⁻¹k[x₁, …, xₙ])` is right Noetherian. -/
theorem isNoetherian_right : IsNoetherian (DiffOp k B)ᵐᵒᵖ (DiffOp k B) :=
  have := isNoetherianRing_base S B
  (isCoordinateFrame S B).isNoetherian_right

/-- `D_k(S⁻¹k[x₁, …, xₙ])` is left Noetherian. -/
theorem isNoetherianRing : IsNoetherianRing (DiffOp k B) :=
  have := isNoetherianRing_base S B
  (isCoordinateFrame S B).isNoetherianRing

/-- The right ideals of `D_k(S⁻¹k[x₁, …, xₙ])` have deviation at most `2n`. -/
theorem devLE_right : Module.DevLE (DiffOp k B)ᵐᵒᵖ (n + n) (DiffOp k B) := by
  have := isNoetherianRing_base S B
  simpa using (isCoordinateFrame S B).devLE_right (ringKrullDim_le S B)

/-- The left ideals of `D_k(S⁻¹k[x₁, …, xₙ])` have deviation at most `2n`. -/
theorem devLE_left : Module.DevLE (DiffOp k B) (n + n) (DiffOp k B) := by
  have := isNoetherianRing_base S B
  simpa using (isCoordinateFrame S B).devLE_left (ringKrullDim_le S B)

/-- The right ideals of `D_k(S⁻¹k[x₁, …, xₙ])` have deviation at most omega. -/
theorem devLEOmega_right : Module.DevLEOmega (DiffOp k B)ᵐᵒᵖ (DiffOp k B) :=
  have := isNoetherianRing_base S B
  (isCoordinateFrame S B).devLEOmega_right (ringKrullDim_le S B)

/-- The left ideals of `D_k(S⁻¹k[x₁, …, xₙ])` have deviation at most omega. -/
theorem devLEOmega_left : Module.DevLEOmega (DiffOp k B) (DiffOp k B) :=
  have := isNoetherianRing_base S B
  (isCoordinateFrame S B).devLEOmega_left (ringKrullDim_le S B)

/-! ## Simplicity, domain, centre -/

variable {S} (hS : S ≤ nonZeroDivisors (MvPolynomial (Fin n) k))
include hS

omit [CharZero k] [Algebra k B] [IsScalarTower k (MvPolynomial (Fin n) k) B] in
/-- `B` is a domain when `0 ∉ S`. -/
theorem isDomain_base : IsDomain B :=
  IsLocalization.isDomain_of_le_nonZeroDivisors B hS

/-- **The only nonzero ideal of `B` stable under all `∂ᵢ` is `B`.** A nonzero
`b ∈ J` has a nonzero polynomial numerator `r = b s ∈ J`; applying partial
derivatives lowers its total degree until a nonzero constant, a unit, lies
in `J`. -/
theorem eq_top_of_pderiv_mem (J : Ideal B) (hJ : J ≠ ⊥)
    (hD : ∀ i, ∀ f ∈ J, localizedPderiv S B i f ∈ J) : J = ⊤ := by
  have hinj := IsLocalization.injective B hS
  have hpd : ∀ i (p : MvPolynomial (Fin n) k),
      localizedPderiv S B i (algebraMap _ B p) = algebraMap _ B (pderiv i p) :=
    fun i p => Derivation.congr_fun (localizedPderiv_compAlgebraMap S B i) p
  have key : ∀ d, ∀ p : MvPolynomial (Fin n) k, p.totalDegree ≤ d → p ≠ 0 →
      algebraMap _ B p ∈ J → J = ⊤ := by
    intro d
    induction d with
    | zero =>
        intro p hp hp0 hpJ
        obtain ⟨c, rfl⟩ : ∃ c, p = C c := ⟨_, totalDegree_eq_zero_iff_eq_C.mp (by omega)⟩
        have hc : c ≠ 0 := fun h => hp0 (by rw [h, C_0])
        rw [← MvPolynomial.algebraMap_eq, ← IsScalarTower.algebraMap_apply] at hpJ
        exact Ideal.eq_top_of_isUnit_mem J hpJ ((IsUnit.mk0 c hc).map (algebraMap k B))
    | succ d ih =>
        intro p hp hp0 hpJ
        by_cases hall : ∀ i, pderiv i p = 0
        · rw [eq_C_of_pderiv_eq_zero hall] at hpJ hp0
          exact ih _ (by simp) hp0 hpJ
        · push Not at hall
          obtain ⟨i, hi⟩ := hall
          refine ih _ ((totalDegree_pderiv_le p i).trans (by omega)) hi ?_
          rw [← hpd]
          exact hD i _ hpJ
  obtain ⟨b, hbJ, hb0⟩ := Submodule.exists_mem_ne_zero_of_ne_bot hJ
  obtain ⟨⟨r, s⟩, hrs⟩ := IsLocalization.surj S b
  refine key _ r le_rfl (fun hr => hb0 ?_) (hrs ▸ J.mul_mem_right _ hbJ)
  rw [hr, map_zero] at hrs
  exact (IsLocalization.map_units B s).mul_left_eq_zero.mp hrs

/-- **`D_k(S⁻¹k[x₁, …, xₙ])` is simple** in characteristic zero, for `0 ∉ S`. -/
theorem isSimpleRing : IsSimpleRing (DiffOp k B) :=
  have := isDomain_base B hS
  isSimpleRing_of_derivation fun J hJ hD => eq_top_of_pderiv_mem B hS J hJ fun _ => hD _

/-- **`D_k(S⁻¹k[x₁, …, xₙ])` is a domain** in characteristic zero, for `0 ∉ S`. -/
theorem isDomain : IsDomain (DiffOp k B) :=
  have := isDomain_base B hS
  (isCoordinateFrame S B).isDomain

omit [IsScalarTower k (MvPolynomial (Fin n) k) B] in
/-- **`D_k(S⁻¹k[x₁, …, xₙ])` has infinite centre** in characteristic zero, for
`0 ∉ S`. -/
theorem infinite_center : Infinite (Subring.center (DiffOp k B)) :=
  have := isDomain_base B hS
  have : Infinite k := CharZero.infinite k
  DifferentialOperators.infinite_center k B

end AlgebraicAnalysis.DifferentialOperators.LocalizedPolynomialOperators
