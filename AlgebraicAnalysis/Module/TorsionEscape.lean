module
public import AlgebraicAnalysis.Ore.Noetherian
public import AlgebraicAnalysis.LinearAlgebra.DivisionPencil

@[expose] public section

/-!
# Escape in torsion bimodules

Right `R`-modules are left modules over `Rᵐᵒᵖ`. The left division-ring
action commutes with this action. No simplicity of the module is required.
-/

namespace AlgebraicAnalysis.TorsionEscape

open MulOpposite
open OreRightIntersection DenominatorTorsion

variable {R E W : Type*} [Ring R] [IsDomain R] [DivisionRing E]
variable [AddCommGroup W] [Module Rᵐᵒᵖ W] [Module E W]
variable [SMulCommClass Rᵐᵒᵖ E W]

/-- The right annihilator of a vector, as a right ideal. -/
def rightAnnihilator (w : W) : Submodule Rᵐᵒᵖ R where
  carrier := {r | op r • w = 0}
  zero_mem' := zero_smul _ _
  add_mem' := by
    intro r s hr hs
    change op r • w = 0 at hr
    change op s • w = 0 at hs
    change op (r + s) • w = 0
    rw [op_add, add_smul, hr, hs, add_zero]
  smul_mem' := by
    intro r s hs
    change op (s * unop r) • w = 0
    rw [op_mul, op_unop, mul_smul, hs, smul_zero]

/-- A finite-dimensional subspace of an ordinary torsion bimodule has a
common nonzero right annihilator. The scalar actions need only commute. -/
theorem exists_common_annihilator (hOre : RightOreCondition R)
    (hW : IsTorsionRight (R := R) (M := W))
    (Y : Submodule E W) [Module.Finite E Y] :
    ∃ c : R, c ≠ 0 ∧ ∀ y ∈ Y, op c • y = 0 := by
  classical
  let B := Module.finBasis E Y
  obtain ⟨c, hc, hcB⟩ := exists_mem_finset_rightIdeals Finset.univ
    (fun i => rightAnnihilator (R := R) (B i : W))
    (fun i _ => by
      obtain ⟨r, hr, hri⟩ := hW (B i : W)
      exact ⟨r, hri, hr⟩) hOre
  refine ⟨c, hc, ?_⟩
  intro y hy
  have heq := congrArg (fun z : Y => (z : W)) (B.sum_repr ⟨y, hy⟩)
  simp only [Submodule.coe_sum, Submodule.coe_smul] at heq
  rw [← heq, Finset.smul_sum]
  apply Finset.sum_eq_zero
  intro i _
  rw [smul_comm, show op c • (B i : W) = 0 from hcB i (Finset.mem_univ i), smul_zero]

/-- The two-sided annihilator of the cyclic right module generated by `g`.
Its definition quantifies over `gR`, avoiding a choice of generators. -/
def cyclicAnnihilator (g : W) : TwoSidedIdeal R :=
  TwoSidedIdeal.mk' {c | ∀ r : R, op (r * c) • g = 0}
    (by simp)
    (by
      intro x y hx hy r
      rw [mul_add, op_add, add_smul, hx r, hy r, add_zero])
    (by intro x hx r; rw [mul_neg, op_neg, neg_smul, hx r, neg_zero])
    (by intro x y hy r; simpa only [← mul_assoc] using hy (r * x))
    (by
      intro x y hx r
      rw [← mul_assoc, op_mul, mul_smul, hx r, smul_zero])

/-- In a simple right Ore domain, a nonzero vector in a torsion bimodule
escapes every finite-dimensional left subspace even with a prescribed nonzero
right tail: `g R b` cannot be contained in that subspace. -/
theorem exists_smul_mul_not_mem [IsSimpleRing R]
    (hOre : RightOreCondition R) (hW : IsTorsionRight (R := R) (M := W))
    {g : W} (hg : g ≠ 0) {b : R} (hb : b ≠ 0)
    (Y : Submodule E W) [Module.Finite E Y] :
    ∃ r : R, op (r * b) • g ∉ Y := by
  classical
  by_contra! h
  obtain ⟨c, hc, hcY⟩ := exists_common_annihilator hOre hW Y
  have hbc : b * c ∈ cyclicAnnihilator g := by
    simp only [cyclicAnnihilator, TwoSidedIdeal.mem_mk', Set.mem_ofPred_eq]
    intro r
    rw [← mul_assoc, op_mul, mul_smul]
    exact hcY _ (h r)
  have h1 := IsSimpleRing.one_mem_of_ne_zero_mem (cyclicAnnihilator g)
    (mul_ne_zero hb hc) hbc
  have hzero := h1 1
  exact hg (by simpa using hzero)

/-- Right multiplication is linear for the commuting left action. -/
def rightMulLinear (r : R) : W →ₗ[E] W where
  toFun w := op r • w
  map_add' := smul_add _
  map_smul' e w := smul_comm _ e w

section Pencils

variable {k D : Type*} [Field k] [AddCommGroup D] [Module E D]

/-- A pencil with central coefficients, as an `E`-linear map. -/
def centralPencil (κ : k →+* E) (hκ : ∀ c a, κ c * a = a * κ c)
    (P Q : D →ₗ[E] W) (c : k) : D →ₗ[E] W where
  toFun d := P d + κ c • Q d
  map_add' x y := by simp only [map_add, smul_add]; abel
  map_smul' a x := by
    simp only [map_smul, RingHom.id_apply, smul_add, smul_smul, hκ]

/-- The injectivity formulation of the central pencil theorem. -/
theorem centralPencil_injective_finite [Module.Finite E D]
    (κ : k →+* E) (hκ : ∀ c a, κ c * a = a * κ c)
    (P Q : D →ₗ[E] W) (hP : Function.Injective P) :
    {c | ¬ Function.Injective (centralPencil κ hκ P Q c)}.Finite := by
  refine (AlgebraicAnalysis.pencil_ker_finite κ hκ P Q hP).subset ?_
  intro c hc
  by_contra hn
  apply hc
  apply LinearMap.ker_eq_bot.mp
  apply LinearMap.ker_eq_bot'.mpr
  intro d hd
  by_contra hd0
  exact hn ⟨d, hd0, hd⟩

/-- A pencil is also generically injective when its second coefficient is
injective. Zero may now be exceptional. -/
theorem reversed_centralPencil_injective_finite [Module.Finite E D]
    (κ : k →+* E) (hκ : ∀ c a, κ c * a = a * κ c)
    (P Q : D →ₗ[E] W) (hQ : Function.Injective Q) :
    {c | ¬ Function.Injective (centralPencil κ hκ P Q c)}.Finite := by
  have hf := Set.Finite.preimage (fun _ _ _ _ h => inv_injective h)
    (centralPencil_injective_finite κ hκ Q P hQ)
  refine (hf.union (Set.finite_singleton 0)).subset ?_
  intro c hc
  by_cases hc0 : c = 0
  · exact Or.inr hc0
  left
  intro hreverse
  apply hc
  intro x y hxy
  apply hreverse
  change P x + κ c • Q x = P y + κ c • Q y at hxy
  change Q x + κ (c⁻¹) • P x = Q y + κ (c⁻¹) • P y
  have hcE : κ c ≠ 0 := by simpa using κ.injective.ne hc0
  have h := congrArg (fun w : W => (κ c)⁻¹ • w) hxy
  simpa only [smul_add, inv_smul_smul₀ hcE, map_inv₀, add_comm] using h

end Pencils

section Rank

variable {k D : Type*} [Field k] [Infinite k]
variable [AddCommGroup D] [Module E D] [Module.Finite E D]

omit [IsDomain R] [Module Rᵐᵒᵖ W] [SMulCommClass Rᵐᵒᵖ E W] in
/-- The maximal-rank argument for a linear family. Its escape hypothesis
requires a value outside every finite-dimensional subspace for each nonzero
domain vector. This separates the linear argument from torsion and simplicity. -/
theorem exists_injective_of_escape
    (σ : k →+* R) (κ : k →+* E) (hκ : ∀ c a, κ c * a = a * κ c)
    (F : R → D →ₗ[E] W)
    (hF : ∀ r s c d, F (r + σ c * s) d = F r d + κ c • F s d)
    (hescape : ∀ d : D, d ≠ 0 → ∀ Y : Submodule E W,
      Module.Finite E Y → ∃ r : R, F r d ∉ Y) :
    ∃ r : R, Function.Injective (F r) := by
  classical
  have hbounded : BddAbove (Set.range fun r => Module.finrank E (LinearMap.range (F r))) :=
    ⟨Module.finrank E D, by rintro _ ⟨r, rfl⟩; exact (F r).finrank_range_le⟩
  obtain ⟨n, ⟨r₀, rfl⟩, hmax⟩ :=
    hbounded.exists_isGreatest_of_nonempty ⟨_, 0, rfl⟩
  by_contra! hnone
  have hker : LinearMap.ker (F r₀) ≠ ⊥ := by
    intro h
    exact hnone r₀ (LinearMap.ker_eq_bot.mp h)
  obtain ⟨d, hdker, hd⟩ := Submodule.exists_mem_ne_zero_of_ne_bot hker
  have hd0 : F r₀ d = 0 := hdker
  let Y := LinearMap.range (F r₀)
  obtain ⟨r, hr⟩ := hescape d hd Y inferInstance
  let w := F r d
  obtain ⟨j, hj⟩ := (F r₀).rangeRestrict.exists_rightInverse_of_surjective
    (F r₀).range_rangeRestrict
  have hj' (y : Y) : F r₀ (j y) = (y : W) :=
    congrArg Subtype.val (LinearMap.congr_fun hj y)
  let A : Y × E →ₗ[E] W := Y.subtype.comp (LinearMap.fst E Y E) +
    (LinearMap.toSpanSingleton E W w).comp (LinearMap.snd E Y E)
  let Q : Y × E →ₗ[E] W := (F r).comp (j.comp (LinearMap.fst E Y E))
  have hA : Function.Injective A := by
    apply LinearMap.ker_eq_bot.mp
    apply LinearMap.ker_eq_bot'.mpr
    rintro ⟨y, a⟩ ha
    change (y : W) + a • w = 0 at ha
    have ha0 : a = 0 := by
      by_contra ha0
      apply hr
      have hm : a • w ∈ Y := (eq_neg_of_add_eq_zero_right ha) ▸ Y.neg_mem y.property
      exact (Y.smul_mem_iff ha0).mp hm
    subst a
    simp only [zero_smul, add_zero] at ha
    exact Prod.ext (Subtype.ext ha) rfl
  obtain ⟨c, hc⟩ := ((centralPencil_injective_finite κ hκ A Q hA).union
    (Set.finite_singleton 0)).exists_notMem
  have hc0 : c ≠ 0 := fun h => hc (Or.inr h)
  have hcE : κ c ≠ 0 := by simpa using κ.injective.ne hc0
  have hAc : Function.Injective (centralPencil κ hκ A Q c) := by
    by_contra hn
    exact hc (Or.inl hn)
  let J : Y × E →ₗ[E] D := j.comp (LinearMap.fst E Y E) +
    (LinearMap.toSpanSingleton E D ((κ c)⁻¹ • d)).comp (LinearMap.snd E Y E)
  have hcomp : (F (r₀ + σ c * r)).comp J = centralPencil κ hκ A Q c := by
    apply LinearMap.ext
    rintro ⟨y, a⟩
    change F (r₀ + σ c * r) (j y + a • ((κ c)⁻¹ • d)) =
      (y : W) + a • w + κ c • F r (j y)
    rw [map_add, map_smul, map_smul, hF, hj', hF, hd0, zero_add]
    rw [smul_smul, smul_smul, mul_assoc, inv_mul_cancel₀ hcE, mul_one]
    abel
  have hJ : Function.Injective ((F (r₀ + σ c * r)).comp J) := hcomp ▸ hAc
  have hinj : Function.Injective ((F (r₀ + σ c * r)).rangeRestrict.comp J) := by
    intro x y hxy
    exact hJ (congrArg Subtype.val hxy)
  have hdim := LinearMap.finrank_le_finrank_of_injective hinj
  have hbound := hmax (Set.mem_range_self (r₀ + σ c * r))
  change Module.finrank E (LinearMap.range (F (r₀ + σ c * r))) ≤ Module.finrank E Y at hbound
  rw [Module.finrank_prod, Module.finrank_self] at hdim
  omega

/-- A finite-dimensional injective map into a torsion bimodule can be
followed by right multiplication with a prescribed nonzero tail and remain
injective. Scalars in `k` act compatibly on the two sides. -/
theorem exists_injective_right_mul [IsSimpleRing R]
    (hOre : RightOreCondition R) (hW : IsTorsionRight (R := R) (M := W))
    (σ : k →+* R) (κ : k →+* E) (hκ : ∀ c a, κ c * a = a * κ c)
    (hscalar : ∀ c (w : W), op (σ c) • w = κ c • w)
    (P : D →ₗ[E] W) (hP : Function.Injective P) {b : R} (hb : b ≠ 0) :
    ∃ r : R, Function.Injective ((rightMulLinear (E := E) (r * b)).comp P) := by
  apply exists_injective_of_escape σ κ hκ
    (fun r => (rightMulLinear (E := E) (r * b)).comp P)
  · intro r s c d
    change op ((r + σ c * s) * b) • P d =
      op (r * b) • P d + κ c • (op (s * b) • P d)
    rw [add_mul, op_add, add_smul, mul_assoc]
    congr 1
    rw [op_mul, mul_smul, hscalar, smul_comm]
  · intro d hd Y hY
    let := hY
    exact exists_smul_mul_not_mem hOre hW
      (fun h => hd (hP (h.trans (map_zero P).symm))) hb Y

end Rank

section FiniteSelection

variable {ι k : Type*} [Field k] [Infinite k]
variable {Eᵢ Dᵢ Wᵢ : ι → Type*}
variable [∀ i, DivisionRing (Eᵢ i)]
variable [∀ i, AddCommGroup (Dᵢ i)] [∀ i, Module (Eᵢ i) (Dᵢ i)]
variable [∀ i, Module.Finite (Eᵢ i) (Dᵢ i)]
variable [∀ i, AddCommGroup (Wᵢ i)] [∀ i, Module (Eᵢ i) (Wᵢ i)]

omit [IsDomain R] in
/-- Finitely many linear families, possibly over different division rings,
have a common injective value if each has an injective value and their
restrictions to scalar lines are central pencils. -/
theorem exists_simultaneously_injective
    (σ : k →+* R) (κ : ∀ i, k →+* Eᵢ i)
    (hκ : ∀ i c a, κ i c * a = a * κ i c)
    (F : ∀ i, R → Dᵢ i →ₗ[Eᵢ i] Wᵢ i)
    (hF : ∀ i r t c d, F i (r + σ c * t) d = F i r d + κ i c • F i t d)
    (s : Finset ι) (hgood : ∀ i ∈ s, ∃ r, Function.Injective (F i r)) :
    ∃ r, ∀ i ∈ s, Function.Injective (F i r) := by
  classical
  induction s using Finset.induction_on with
  | empty => exact ⟨0, by simp⟩
  | @insert i s hi ih =>
    obtain ⟨r₀, hr₀⟩ := ih (fun j hj => hgood j (Finset.mem_insert_of_mem hj))
    obtain ⟨r₁, hr₁⟩ := hgood i (Finset.mem_insert_self i s)
    have hold : (⋃ j ∈ s,
        {c | ¬ Function.Injective (centralPencil (κ j) (hκ j) (F j r₀) (F j r₁) c)}).Finite :=
      s.finite_toSet.biUnion fun j hj =>
        centralPencil_injective_finite (κ j) (hκ j) _ _ (hr₀ j hj)
    have hnew := reversed_centralPencil_injective_finite (κ i) (hκ i)
      (F i r₀) (F i r₁) hr₁
    obtain ⟨c, hc⟩ := (hold.union hnew).exists_notMem
    refine ⟨r₀ + σ c * r₁, ?_⟩
    intro j hj
    have hp : Function.Injective
        (centralPencil (κ j) (hκ j) (F j r₀) (F j r₁) c) := by
      by_contra hn
      by_cases hji : j = i
      · subst j
        exact hc (Or.inr hn)
      · have hjs : j ∈ s := (Finset.mem_insert.mp hj).resolve_left hji
        exact hc (Or.inl (Set.mem_iUnion.mpr ⟨j, Set.mem_iUnion.mpr ⟨hjs, hn⟩⟩))
    intro x y hxy
    apply hp
    change F j r₀ x + κ j c • F j r₁ x = F j r₀ y + κ j c • F j r₁ y
    simpa only [hF] using hxy

variable [∀ i, Module Rᵐᵒᵖ (Wᵢ i)] [∀ i, SMulCommClass Rᵐᵒᵖ (Eᵢ i) (Wᵢ i)]

/-- Finite affine source selection in torsion bimodules. There is one
direction `H` such that every map with source `B + σ(c) H a` is injective
outside a finite set of central scalars. Offsets and division rings may vary
with the test. The prescribed right tail is `a bᵢ`. -/
theorem exists_affine_direction [IsSimpleRing R]
    (hOre : RightOreCondition R)
    (hW : ∀ i, IsTorsionRight (R := R) (M := Wᵢ i))
    (σ : k →+* R) (κ : ∀ i, k →+* Eᵢ i)
    (hκ : ∀ i c a, κ i c * a = a * κ i c)
    (hscalar : ∀ i c (w : Wᵢ i), op (σ c) • w = κ i c • w)
    (P Z : ∀ i, Dᵢ i →ₗ[Eᵢ i] Wᵢ i) (hP : ∀ i, Function.Injective (P i))
    (s : Finset ι) (b : ι → R) (hb : ∀ i ∈ s, b i ≠ 0)
    {a : R} (ha : a ≠ 0) (B : R) :
    ∃ H : R, {c : k | ∃ i ∈ s, ¬ Function.Injective
      (fun d => Z i d + op ((B + σ c * H * a) * b i) • P i d)}.Finite := by
  classical
  let F (i : ι) (r : R) : Dᵢ i →ₗ[Eᵢ i] Wᵢ i :=
    (rightMulLinear (E := Eᵢ i) (r * (a * b i))).comp (P i)
  have hF (i : ι) (r t : R) (c : k) (d : Dᵢ i) :
      F i (r + σ c * t) d = F i r d + κ i c • F i t d := by
    change op ((r + σ c * t) * (a * b i)) • P i d =
      op (r * (a * b i)) • P i d + κ i c • (op (t * (a * b i)) • P i d)
    rw [add_mul, op_add, add_smul, mul_assoc]
    congr 1
    rw [op_mul, mul_smul, hscalar, smul_comm]
  obtain ⟨H, hH⟩ := exists_simultaneously_injective σ κ hκ F hF s (fun i hi =>
    exists_injective_right_mul hOre (hW i) σ (κ i) (hκ i) (hscalar i)
      (P i) (hP i) (mul_ne_zero ha (hb i hi)))
  let A (i : ι) : Dᵢ i →ₗ[Eᵢ i] Wᵢ i :=
    Z i + (rightMulLinear (E := Eᵢ i) (B * b i)).comp (P i)
  have hfinite : (⋃ i ∈ s,
      {c | ¬ Function.Injective (centralPencil (κ i) (hκ i) (A i) (F i H) c)}).Finite :=
    s.finite_toSet.biUnion fun i hi =>
      reversed_centralPencil_injective_finite (κ i) (hκ i) _ _ (hH i hi)
  refine ⟨H, hfinite.subset ?_⟩
  rintro c ⟨i, hi, hbad⟩
  refine Set.mem_iUnion.mpr ⟨i, Set.mem_iUnion.mpr ⟨hi, ?_⟩⟩
  have heq : (fun d => Z i d + op ((B + σ c * H * a) * b i) • P i d) =
      centralPencil (κ i) (hκ i) (A i) (F i H) c := by
    funext d
    change Z i d + op ((B + σ c * H * a) * b i) • P i d =
      (Z i d + op (B * b i) • P i d) + κ i c • (op (H * (a * b i)) • P i d)
    have hscaled : op (σ c * (H * (a * b i))) • P i d =
        κ i c • (op (H * (a * b i)) • P i d) := by
      rw [op_mul, mul_smul, hscalar, smul_comm]
    rw [add_mul, op_add, add_smul, mul_assoc, mul_assoc, hscaled]
    abel
  change ¬ Function.Injective (centralPencil (κ i) (hκ i) (A i) (F i H) c)
  rwa [← heq]

/-- The actual source `B + H a` supplied by finite affine selection. -/
theorem exists_affine_source [IsSimpleRing R]
    (hOre : RightOreCondition R)
    (hW : ∀ i, IsTorsionRight (R := R) (M := Wᵢ i))
    (σ : k →+* R) (κ : ∀ i, k →+* Eᵢ i)
    (hκ : ∀ i c a, κ i c * a = a * κ i c)
    (hscalar : ∀ i c (w : Wᵢ i), op (σ c) • w = κ i c • w)
    (P Z : ∀ i, Dᵢ i →ₗ[Eᵢ i] Wᵢ i) (hP : ∀ i, Function.Injective (P i))
    (s : Finset ι) (b : ι → R) (hb : ∀ i ∈ s, b i ≠ 0)
    {a : R} (ha : a ≠ 0) (B : R) :
    ∃ H : R, ∀ i ∈ s, Function.Injective
      (fun d => Z i d + op ((B + H * a) * b i) • P i d) := by
  obtain ⟨H, hH⟩ := exists_affine_direction hOre hW σ κ hκ hscalar P Z hP s b hb ha B
  obtain ⟨c, hc⟩ := hH.exists_notMem
  refine ⟨σ c * H, ?_⟩
  intro i hi
  by_contra hbad
  exact hc ⟨i, hi, hbad⟩

end FiniteSelection

end AlgebraicAnalysis.TorsionEscape
