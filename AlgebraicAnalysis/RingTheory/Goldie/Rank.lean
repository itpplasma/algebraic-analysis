module

public import AlgebraicAnalysis.RingTheory.Goldie.QuotientRing
public import AlgebraicAnalysis.RingTheory.Goldie.Torsion
public import AlgebraicAnalysis.Ore.ModuleLocalization

@[expose] public section

/-!
# Goldie rank of modules over a simple right Noetherian ring

Let `R` be a ring whose regular elements form a right Ore set, with classical
right quotient ring `Q` (`Goldie.QuotientRing R`). For a right `R`-module `M`
the module of fractions `M_Q` consists of the fractions `m s⁻¹` with `s`
regular; it is a right `Q`-module. In Lean, right `R`-modules are
`Rᵐᵒᵖ`-modules, `M_Q` is Mathlib's Ore localization of `M` at the opposite copy
of `R⁰` (`Goldie.FractionModule R M`), and it is a left module over
`Q° = Goldie.OppositeQuotientRing R`, i.e. a right `Q`-module.

* `Goldie.goldieTorsionPart R M`: the Goldie-torsion part `t(M)`, the span of
  the elements killed by a regular element. It is the kernel of `M → M_Q`
  (`Goldie.ker_toFractionModule`), so these elements already form a submodule
  (`Goldie.mem_goldieTorsionPart_iff`).
* `Goldie.goldieRank R M = length_Q(M_Q)` (in `ℕ∞`). It is additive on short
  exact sequences (`Goldie.goldieRank_eq_add_of_exact`), since localization is
  exact; it is monotone under injective maps and decreases under quotients;
  `goldieRank R (Fin m → Rᵐᵒᵖ) = m * goldieRank R R`; and it vanishes exactly on
  Goldie-torsion modules (`Goldie.goldieRank_eq_zero_iff`).

Now assume `R` is simple and right Noetherian, so that `Q` is simple Artinian
(Goldie's theorem, `AlgebraicAnalysis.RingTheory.Goldie.QuotientRing`).

* `Goldie.goldieRank_ne_top`: a finitely generated `M` has finite Goldie rank,
  and `Goldie.goldieRank_self = length_Q(Q_Q)` is finite and positive.
* **Uniform dimension.** `Goldie.uniformDimGE_quotient_iff`,
  `Goldie.uniformDimLE_quotient_iff`: the uniform dimension of `M/t(M)` is the
  Goldie rank of `M`; `Goldie.uniformDimGE_self_iff`,
  `Goldie.uniformDimLE_self_iff`: the uniform dimension of `R_R` is
  `goldieRank R R = length_Q(Q_Q)`.
* `Goldie.goldieRank_le_card_mul`: a module generated by `m` elements has
  Goldie rank at most `m * goldieRank R R`; in uniform-dimension form
  `Goldie.le_mul_of_uniformDim`.

## Proof of the uniform dimension bridge

The map `M/t(M) → M_Q` is injective, and `(m s⁻¹) s = m` lies in its image for
every fraction. Hence `M/t(M)` and `M_Q` contain direct sums of the same numbers
of nonzero submodules (`OreModule.uniformDimGE_iff_of_injective`, by
saturating submodules). As `Q` is semisimple, so is `M_Q`, and its uniform
dimension is its length (`Module.uniformDimGE_iff_le_length`).

## References

J. C. McConnell and J. C. Robson, *Noncommutative Noetherian Rings*, 2.1.16–2.1.17,
2.2.10–2.2.13 and 2.3.6; K. R. Goodearl and R. B. Warfield, *An Introduction to
Noncommutative Noetherian Rings*, 2nd ed., Chapters 5, 6 and 10. Nothing here is
new.
-/

namespace AlgebraicAnalysis.Goldie

open MulOpposite nonZeroDivisors OreRightLocalization AlgebraicAnalysis.Module
  AlgebraicAnalysis.OreModule

universe u v w

section Definitions

variable (R : Type u) [Ring R] (M : Type v) [AddCommGroup M] [Module Rᵐᵒᵖ M]

/-- The Goldie-torsion part `t(M)` of a right `R`-module `M`: the submodule
spanned by the elements `m` with `m s = 0` for some regular `s`. Under a right
Ore condition these elements already form a submodule
(`mem_goldieTorsionPart_iff`). -/
def goldieTorsionPart : Submodule Rᵐᵒᵖ M :=
  Submodule.span Rᵐᵒᵖ {m : M | ∃ s ∈ R⁰, op s • m = 0}

variable [OreLocalization.OreSet (oppositeSubmonoid R⁰)]

/-- The module of fractions `M_Q` of a right `R`-module `M`: Mathlib's Ore
localization of `M` at the regular elements, a left module over
`Q° = OppositeQuotientRing R`, that is, a right module over the classical right
quotient ring `Q`. -/
abbrev FractionModule : Type (max u v) := OreLocalization (oppositeSubmonoid R⁰) M

/-- The canonical map `M → M_Q`, `m ↦ m 1⁻¹`. -/
abbrev toFractionModule : M →ₗ[Rᵐᵒᵖ] FractionModule R M :=
  toLocalization (oppositeSubmonoid R⁰) M

/-- The **Goldie rank** `length_Q(M ⊗_R Q)` of a right `R`-module `M`, the length
of its module of fractions `M_Q` as a right `Q`-module. It is finite for
finitely generated `M` over a simple right Noetherian ring (`goldieRank_ne_top`).
The normalized rank of the paper is `goldieRank R M / goldieRank R R`. -/
noncomputable def goldieRank : ℕ∞ :=
  Module.length (OppositeQuotientRing R) (FractionModule R M)

end Definitions

variable {R : Type u} [Ring R] [OreLocalization.OreSet (oppositeSubmonoid R⁰)]
variable {M : Type v} [AddCommGroup M] [Module Rᵐᵒᵖ M]
variable {N : Type w} [AddCommGroup N] [Module Rᵐᵒᵖ N]
variable {P : Type*} [AddCommGroup P] [Module Rᵐᵒᵖ P]

section Torsion

/-- An element maps to zero in `M_Q` iff it is killed by a regular element. -/
theorem toFractionModule_eq_zero_iff {m : M} :
    toFractionModule R M m = 0 ↔ ∃ s ∈ R⁰, op s • m = 0 := by
  rw [toLocalization_eq_zero_iff]
  exact ⟨fun ⟨s, hs, h⟩ => ⟨unop s, hs, h⟩, fun ⟨s, hs, h⟩ => ⟨op s, hs, h⟩⟩

variable (R M) in
/-- The Goldie-torsion part is the kernel of `M → M_Q`. -/
theorem ker_toFractionModule : LinearMap.ker (toFractionModule R M) = goldieTorsionPart R M := by
  apply le_antisymm
  · intro m hm
    exact Submodule.subset_span (toFractionModule_eq_zero_iff.mp hm)
  · rw [goldieTorsionPart, Submodule.span_le]
    intro m hm
    exact toFractionModule_eq_zero_iff.mpr hm

/-- **The Goldie-torsion elements form a submodule.** `m ∈ t(M)` iff `m s = 0`
for some regular `s`. -/
theorem mem_goldieTorsionPart_iff {m : M} :
    m ∈ goldieTorsionPart R M ↔ ∃ s ∈ R⁰, op s • m = 0 := by
  rw [← ker_toFractionModule, LinearMap.mem_ker, toFractionModule_eq_zero_iff]

/-- `M` is Goldie-torsion iff `t(M) = M`. -/
theorem goldieTorsionPart_eq_top_iff : goldieTorsionPart R M = ⊤ ↔ IsGoldieTorsion R M := by
  rw [eq_top_iff]
  exact ⟨fun h m => mem_goldieTorsionPart_iff.mp (h Submodule.mem_top),
    fun h m _ => mem_goldieTorsionPart_iff.mpr (h m)⟩

variable (R) in
/-- `R_R` has no Goldie torsion: a regular element kills no nonzero element. -/
theorem goldieTorsionPart_self : goldieTorsionPart R R = ⊥ := by
  rw [eq_bot_iff]
  intro r hr
  obtain ⟨s, hs, h⟩ := mem_goldieTorsionPart_iff.mp hr
  exact (Submodule.mem_bot _).mpr (hs.2 r h)

/-- Every element of `M_Q` is multiplied into the image of `M` by a regular
element: `(m s⁻¹) s = m`. -/
theorem exists_smul_mem_range (x : FractionModule R M) :
    ∃ s ∈ oppositeSubmonoid R⁰, s • x ∈ LinearMap.range (toFractionModule R M) := by
  induction x using OreLocalization.ind with | _ m s =>
  exact ⟨s, s.2, m, (smul_oreDiv_self m s).symm⟩

/-- The injective map `M/t(M) → M_Q` induced by `M → M_Q`. -/
noncomputable def quotientToFractionModule :
    (M ⧸ goldieTorsionPart R M) →ₗ[Rᵐᵒᵖ] FractionModule R M :=
  (goldieTorsionPart R M).liftQ (toFractionModule R M) (ker_toFractionModule R M).ge

/-- The map `M/t(M) → M_Q` is injective. -/
theorem quotientToFractionModule_injective :
    Function.Injective (quotientToFractionModule (R := R) (M := M)) := by
  rw [← LinearMap.ker_eq_bot]
  exact Submodule.ker_liftQ_eq_bot _ _ _ (ker_toFractionModule R M).le

end Torsion

section Rank

/-- **Additivity of Goldie rank.** For a short exact sequence
`0 → M → N → P → 0` of right `R`-modules, `rk N = rk M + rk P`; localization is
exact and length is additive. -/
theorem goldieRank_eq_add_of_exact {f : M →ₗ[Rᵐᵒᵖ] N} {g : N →ₗ[Rᵐᵒᵖ] P}
    (hf : Function.Injective f) (hg : Function.Surjective g) (hfg : Function.Exact f g) :
    goldieRank R N = goldieRank R M + goldieRank R P :=
  Module.length_eq_add_of_exact _ _ (localizationMap_injective hf) (localizationMap_surjective hg)
    (localizationMap_exact hfg)

/-- Goldie rank is monotone under injective maps. -/
theorem goldieRank_le_of_injective {f : M →ₗ[Rᵐᵒᵖ] N} (hf : Function.Injective f) :
    goldieRank R M ≤ goldieRank R N :=
  Module.length_le_of_injective _ (localizationMap_injective (S := oppositeSubmonoid R⁰) hf)

/-- Goldie rank does not increase under surjective maps; in particular a
quotient of `M` has Goldie rank at most that of `M`. -/
theorem goldieRank_le_of_surjective {g : N →ₗ[Rᵐᵒᵖ] P} (hg : Function.Surjective g) :
    goldieRank R P ≤ goldieRank R N :=
  Module.length_le_of_surjective _ (localizationMap_surjective (S := oppositeSubmonoid R⁰) hg)

/-- A quotient of `M` has Goldie rank at most that of `M`. -/
theorem goldieRank_quotient_le (K : Submodule Rᵐᵒᵖ M) : goldieRank R (M ⧸ K) ≤ goldieRank R M :=
  goldieRank_le_of_surjective K.mkQ_surjective

/-- A submodule of `M` has Goldie rank at most that of `M`. -/
theorem goldieRank_submodule_le (K : Submodule Rᵐᵒᵖ M) : goldieRank R K ≤ goldieRank R M :=
  goldieRank_le_of_injective K.injective_subtype

/-- Goldie rank is invariant under linear equivalences. -/
theorem goldieRank_congr (e : M ≃ₗ[Rᵐᵒᵖ] N) : goldieRank R M = goldieRank R N :=
  le_antisymm (goldieRank_le_of_injective e.injective) (goldieRank_le_of_surjective e.surjective)

variable (R M N) in
/-- Goldie rank is additive on direct sums. -/
theorem goldieRank_prod : goldieRank R (M × N) = goldieRank R M + goldieRank R N :=
  goldieRank_eq_add_of_exact LinearMap.inl_injective LinearMap.snd_surjective .inl_snd

variable (R M) in
/-- `rk(Mᵐ) = m · rk(M)`. -/
theorem goldieRank_pi_fin (m : ℕ) : goldieRank R (Fin m → M) = m * goldieRank R M := by
  induction m with
  | zero =>
    have : Subsingleton (FractionModule R (Fin 0 → M)) := by
      constructor
      intro p q
      induction p using OreLocalization.ind with | _ x s =>
      induction q using OreLocalization.ind with | _ y t =>
      rw [Subsingleton.elim x 0, Subsingleton.elim y 0, OreLocalization.zero_oreDiv,
        OreLocalization.zero_oreDiv]
    simp [goldieRank, Module.length_eq_zero]
  | succ m ih =>
    rw [← goldieRank_congr (Fin.consLinearEquiv Rᵐᵒᵖ fun _ : Fin (m + 1) => M), goldieRank_prod,
      ih]
    push_cast
    ring

/-- The Goldie rank vanishes exactly on Goldie-torsion modules. -/
theorem goldieRank_eq_zero_iff : goldieRank R M = 0 ↔ IsGoldieTorsion R M := by
  rw [goldieRank, Module.length_eq_zero_iff]
  constructor
  · intro h m
    exact toFractionModule_eq_zero_iff.mp (Subsingleton.elim _ _)
  · intro h
    refine ⟨fun p q => ?_⟩
    suffices ∀ p : FractionModule R M, p = 0 by rw [this p, this q]
    intro p
    induction p using OreLocalization.ind with | _ m s =>
    exact oreDiv_eq_zero_iff.mpr (toFractionModule_eq_zero_iff.mpr (h m))

variable (R) in
/-- The module of fractions of the left regular `Rᵐᵒᵖ`-module is `Q°` itself, so
its Goldie rank is the length of `Q` over itself. -/
theorem goldieRank_op_self :
    goldieRank R Rᵐᵒᵖ = Module.length (OppositeQuotientRing R) (OppositeQuotientRing R) := rfl

variable (R) in
/-- `x ↦ op x` identifies `R`, as a right module over itself, with the left
regular module of `Rᵐᵒᵖ`. -/
def opRegularEquiv : R ≃ₗ[Rᵐᵒᵖ] Rᵐᵒᵖ where
  toFun := op
  invFun := unop
  map_add' _ _ := rfl
  map_smul' c x := by
    change op (x * unop c) = c * op x
    rw [op_mul, op_unop]
  left_inv _ := rfl
  right_inv _ := rfl

variable (R) in
/-- `s = rk(R_R) = length_Q(Q_Q)`. -/
theorem goldieRank_self :
    goldieRank R R = Module.length (OppositeQuotientRing R) (OppositeQuotientRing R) :=
  (goldieRank_congr (opRegularEquiv R)).trans (goldieRank_op_self R)

/-- A right module generated by the finite set `s` has Goldie rank at most
`|s| · rk(R_R)`. -/
theorem goldieRank_le_card_mul (s : Finset M) (hs : Submodule.span Rᵐᵒᵖ (s : Set M) = ⊤) :
    goldieRank R M ≤ s.card * goldieRank R R := by
  let v : Fin s.card → M := fun i => (s.equivFin.symm i : M)
  have hv : Set.range v = (s : Set M) := by
    ext m
    constructor
    · rintro ⟨i, rfl⟩
      exact (s.equivFin.symm i).2
    · intro hm
      exact ⟨s.equivFin ⟨m, hm⟩, by simp [v]⟩
  have hsurj : Function.Surjective (Fintype.linearCombination Rᵐᵒᵖ v) := by
    rw [← LinearMap.range_eq_top, Fintype.range_linearCombination, hv, hs]
  calc goldieRank R M ≤ goldieRank R (Fin s.card → Rᵐᵒᵖ) := goldieRank_le_of_surjective hsurj
    _ = s.card * goldieRank R R := by
      rw [goldieRank_pi_fin, goldieRank_op_self, goldieRank_self]

end Rank

section SimpleNoetherian

variable [IsSimpleRing R] [IsNoetherian Rᵐᵒᵖ R]

/-- The module of fractions of a finitely generated module has finite length:
it is a finitely generated module over the semisimple ring `Q`. -/
theorem goldieRank_ne_top [Module.Finite Rᵐᵒᵖ M] : goldieRank R M ≠ ⊤ := by
  have : Module.Finite (OppositeQuotientRing R) (FractionModule R M) :=
    OreModule.finite (oppositeSubmonoid R⁰) M
  exact Module.length_ne_top

/-- `rk(R_R) = length_Q(Q_Q)` is finite. -/
theorem goldieRank_self_ne_top : goldieRank R R ≠ ⊤ := by
  rw [goldieRank_self]
  exact length_oppositeQuotientRing_ne_top

omit [IsNoetherian Rᵐᵒᵖ R] in
/-- `rk(R_R) = length_Q(Q_Q)` is positive. -/
theorem goldieRank_self_pos : 0 < goldieRank R R := by
  rw [goldieRank_self]
  exact length_oppositeQuotientRing_pos

/-- **Uniform dimension equals Goldie rank.** `M/t(M)` contains a direct sum of
`n` nonzero submodules iff `n ≤ rk(M) = length_Q(M_Q)`. -/
theorem uniformDimGE_quotient_iff {n : ℕ} :
    UniformDimGE Rᵐᵒᵖ (M ⧸ goldieTorsionPart R M) n ↔ (n : ℕ∞) ≤ goldieRank R M := by
  rw [uniformDimGE_iff_of_injective (S := oppositeSubmonoid R⁰) quotientToFractionModule_injective
    fun x => ?_]
  · exact uniformDimGE_iff_le_length
  · obtain ⟨s, hs, m, hm⟩ := exists_smul_mem_range x
    exact ⟨s, hs, Submodule.Quotient.mk m, hm⟩

/-- **Uniform dimension equals Goldie rank.** `M/t(M)` contains no direct sum of
`n + 1` nonzero submodules iff `rk(M) ≤ n`. -/
theorem uniformDimLE_quotient_iff {n : ℕ} :
    UniformDimLE Rᵐᵒᵖ (M ⧸ goldieTorsionPart R M) n ↔ goldieRank R M ≤ n := by
  rw [UniformDimLE, uniformDimGE_quotient_iff, not_le, Nat.cast_add, Nat.cast_one,
    ENat.lt_add_one_iff (ENat.natCast_ne_top n)]

/-- **Uniform dimension of `R_R`.** `R` contains a direct sum of `n` nonzero right
ideals iff `n ≤ rk(R_R) = length_Q(Q_Q)`. -/
theorem uniformDimGE_self_iff {n : ℕ} :
    UniformDimGE Rᵐᵒᵖ R n ↔ (n : ℕ∞) ≤ goldieRank R R := by
  rw [← uniformDimGE_quotient_iff,
    uniformDimGE_congr (Submodule.quotEquivOfEqBot _ (goldieTorsionPart_self R))]

/-- **Uniform dimension of `R_R`.** `R` contains no direct sum of `n + 1` nonzero
right ideals iff `rk(R_R) ≤ n`. -/
theorem uniformDimLE_self_iff {n : ℕ} :
    UniformDimLE Rᵐᵒᵖ R n ↔ goldieRank R R ≤ n := by
  rw [UniformDimLE, uniformDimGE_self_iff, not_le, Nat.cast_add, Nat.cast_one,
    ENat.lt_add_one_iff (ENat.natCast_ne_top n)]

/-- **Generators bound the normalized rank from below** (`⌈ρ(M)⌉ ≤ μ(M)`). If `M`
is generated by a set of at most `m` elements, `M/t(M)` contains a direct sum of
`ℓ` nonzero submodules and `R_R` contains no direct sum of `s + 1` nonzero right
ideals, then `ℓ ≤ m s`. -/
theorem le_mul_of_uniformDim {m ℓ s : ℕ} (g : Finset M) (hg : g.card ≤ m)
    (hspan : Submodule.span Rᵐᵒᵖ (g : Set M) = ⊤)
    (hℓ : UniformDimGE Rᵐᵒᵖ (M ⧸ goldieTorsionPart R M) ℓ) (hs : UniformDimLE Rᵐᵒᵖ R s) :
    ℓ ≤ m * s := by
  have h1 := uniformDimGE_quotient_iff.mp hℓ
  have h2 := goldieRank_le_card_mul g hspan
  have h3 := uniformDimLE_self_iff.mp hs
  have : (ℓ : ℕ∞) ≤ (m * s : ℕ) := by
    calc (ℓ : ℕ∞) ≤ g.card * goldieRank R R := h1.trans h2
      _ ≤ m * s := by gcongr
      _ = (m * s : ℕ) := (Nat.cast_mul m s).symm
  exact_mod_cast this

end SimpleNoetherian

end AlgebraicAnalysis.Goldie
