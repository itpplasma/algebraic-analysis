public import Mathlib.RingTheory.FiniteLength

@[expose] public section

/-!
# Critical-module and filtration oracles

The integer oracle uses principal ideals and finite quotient modules; the
prime-field oracle uses simplicity after restriction of scalars. The
filtration oracle compares its top length with the independent vector-space
rank of a rational plane and an explicit coordinate-axis chain.
-/

namespace AlgebraicAnalysisTest.Critical

private theorem int_quotient_finite (p : Submodule ℤ ℤ) (hp : p ≠ ⊥) :
    Finite (ℤ ⧸ p) := by
  let z := Submodule.IsPrincipal.generator (p : Ideal ℤ)
  have hz : z ≠ 0 := fun h => hp
    ((Submodule.IsPrincipal.eq_bot_iff_generator_eq_zero p).mpr h)
  let : NeZero z := ⟨hz⟩
  rw [← Ideal.span_singleton_generator p]
  infer_instance

/-- `ℤ` has exact deviation one, and every nonzero quotient is finite. -/
theorem int_critical_one : Module.Critical ℤ 1 ℤ := by
  refine ⟨inferInstance, Deviation.int_devLE_one, Deviation.int_not_devLE_zero, ?_⟩
  intro p hp
  have := int_quotient_finite p hp
  exact Module.devLE_zero_iff_isArtinian.mpr isArtinian_of_finite

/-- This checks that the radical is trivial even though `ℤ` has many
nonzero submodules, such as the even integers. -/
example : Module.smallRadical ℤ 1 ℤ = ⊥ := int_critical_one.smallRadical_eq_bot

/-- Prime fields are zero-critical as integer modules, not only over themselves. -/
theorem zmod_critical_zero (p : ℕ) [Fact p.Prime] : Module.Critical ℤ 0 (ZMod p) := by
  have : IsSimpleModule ℤ (ZMod p) :=
    (isSimpleModule_iff_isSimpleModule_of_algebraMap_surjective
      (R := ℤ) (S := ZMod p) (M := ZMod p) ZMod.intCast_surjective).mpr inferInstance
  exact Module.critical_zero_of_isSimpleModule

example : Module.Critical ℤ 0 (ZMod 5) := by
  have : Fact (Nat.Prime 5) := ⟨by decide⟩
  exact zmod_critical_zero 5

/-- A composite residue module is not zero-critical: its proper nonzero
subgroup generated by two has a nonzero quotient. -/
theorem zmod_six_not_critical_zero : ¬Module.Critical ℤ 0 (ZMod 6) := by
  intro h
  let p : Submodule ℤ (ZMod 6) := Submodule.span ℤ {(2 : ZMod 6)}
  have hp : p ≠ ⊥ := by
    intro he
    have hm : (2 : ZMod 6) ∈ p := Submodule.subset_span (by simp)
    rw [he] at hm
    exact (by decide : (2 : ZMod 6) ≠ 0) hm
  have hs : Subsingleton (ZMod 6 ⧸ p) := h.small_quotient p hp
  have ht : p = ⊤ := Submodule.Quotient.subsingleton_iff.mp hs
  have hone : (1 : ZMod 6) ∈ p := ht ▸ Submodule.mem_top
  obtain ⟨a, ha⟩ := Submodule.mem_span_singleton.mp hone
  let f : ZMod 6 →+* ZMod 2 := ZMod.castHom (by norm_num : 2 ∣ 6) (ZMod 2)
  have hf : f 2 = 0 := by decide
  have he := congrArg f ha
  simp only [map_zsmul, hf, smul_zero, map_one] at he
  exact zero_ne_one he

/-- All of a finite residue module lies in the first small radical. -/
example : Module.smallRadical ℤ 1 (ZMod 6) = ⊤ := by
  apply top_le_iff.mp
  apply Module.le_smallRadical
  exact (Module.devLE_zero_iff_isArtinian.mpr
    (isArtinian_of_finite (R := ℤ) (M := ZMod 6))).submodule ⊤

/-- A rational plane for the independent dimension oracle. -/
abbrev Plane := ℚ × ℚ
private def axis : Submodule ℚ Plane := LinearMap.range (LinearMap.inl ℚ ℚ ℚ)

private theorem axis_ne_bot : axis ≠ ⊥ := by
  intro he
  have hm : ((1, 0) : Plane) ∈ axis := ⟨1, rfl⟩
  rw [he] at hm
  norm_num at hm

private theorem axis_ne_top : axis ≠ ⊤ := by
  intro he
  have hm : ((0, 1) : Plane) ∈ axis := he ▸ Submodule.mem_top
  obtain ⟨x, hx⟩ := hm
  have := congrArg Prod.snd hx
  norm_num at this

private def planeChain (i : ℕ) : Submodule ℚ Plane :=
  if i = 0 then ⊥ else if i = 1 then axis else ⊤

private theorem planeChain_monotone : Monotone planeChain := by
  intro i j hij
  simp only [planeChain]
  split_ifs <;> subst_vars <;> first | exact bot_le | exact le_top | exact le_rfl | omega

private theorem not_small_zero_factor {p q : Submodule ℚ Plane} (hpq : p < q) :
    ¬Module.Small ℚ 0 (q ⧸ p.comap q.subtype) := by
  intro hs
  have ht : p.comap q.subtype = ⊤ := Submodule.Quotient.subsingleton_iff.mp hs
  have hqp : q ≤ p := by
    intro x hx
    have hm : (⟨x, hx⟩ : q) ∈ p.comap q.subtype := ht ▸ Submodule.mem_top
    exact hm
  exact hpq.not_ge hqp

/-- A genuine two-factor chain forces every critical filtration to retain
at least two factors at stratum zero. -/
theorem plane_filtration_topLength_ge_two (F : Module.CriticalFiltration ℚ 0 Plane) :
    2 ≤ F.topLength 0 := by
  apply F.non_small_chain_length_le planeChain planeChain_monotone 2
  intro i hi
  interval_cases i
  · exact not_small_zero_factor (bot_lt_iff_ne_bot.mpr axis_ne_bot)
  · exact not_small_zero_factor (lt_top_iff_ne_top.mpr axis_ne_top)

/-- Independent vector-space rank bounds the total number of strict steps. -/
theorem plane_filtration_length_le_two (F : Module.CriticalFiltration ℚ 0 Plane) :
    F.length ≤ 2 := by
  have hsm : StrictMono (fun i => Module.finrank ℚ (F.toRelSeries i)) :=
    Submodule.finrank_strictMono.comp F.strictMono
  have aux : ∀ k (hk : k < F.length + 1),
      k ≤ Module.finrank ℚ (F.toRelSeries ⟨k, hk⟩) := by
    intro k
    induction k with
    | zero => intro hk; omega
    | succ k ih =>
      intro hk
      have hh := ih (by omega)
      have hlt := hsm (show (⟨k, by omega⟩ : Fin (F.length + 1)) < ⟨k + 1, hk⟩ by simp)
      exact Nat.succ_le_of_lt (lt_of_le_of_lt hh hlt)
  have hb := aux F.length (by omega)
  have ht : F.toRelSeries (Fin.last F.length) = ⊤ := F.last_eq_top
  change F.length ≤ Module.finrank ℚ (F.toRelSeries (Fin.last F.length)) at hb
  rw [ht, finrank_top, Module.finrank_prod, Module.finrank_self] at hb
  exact hb

/-- Finite ordinary length gives a finite critical filtration; its length
modulo zero is exactly the independent rank two. -/
theorem plane_critical_filtration :
    ∃ F : Module.CriticalFiltration ℚ 0 Plane, F.topLength 0 = 2 := by
  have hfinite : IsFiniteLength ℚ Plane :=
    isFiniteLength_iff_isNoetherian_isArtinian.mpr ⟨inferInstance, inferInstance⟩
  obtain ⟨hnoeth, hart⟩ := isFiniteLength_iff_isNoetherian_isArtinian.mp hfinite
  obtain ⟨F⟩ := (Module.devLE_zero_iff_isArtinian.mpr hart).nonempty_criticalFiltration
  exact ⟨F, le_antisymm ((F.topLength_le_length 0).trans (plane_filtration_length_le_two F))
    (plane_filtration_topLength_ge_two F)⟩

