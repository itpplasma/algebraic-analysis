module

public import AlgebraicAnalysis.RingTheory.Goldie.Splitting
public import AlgebraicAnalysisTest.RingTheory.GoldieRank

@[expose] public section

/-!
# Concrete oracles for free cyclic submodules and spanning fractions

The checks use the field `ℚ`, whose Goldie rank `goldieRank ℚ ℚ = 1` is the
hand computation `AlgebraicAnalysisTest.GoldieRank.goldieRank_rat`.

* Embedding: over `ℚ`, `ℚ²` satisfies the length hypothesis and the produced
  vector is nonzero; the zero module violates the hypothesis and indeed admits no
  injective orbit map (hostile control).
* Splitting: `M = ℚ × ℚ` has rank `2`, so the produced `p` leaves a quotient of
  rank exactly `1`; independently, `ℚ × ℚ` is not cyclic, since `(0, 1)` is not
  a multiple of `(1, 0)` and vice versa.
* Successive choice: for `M = ℚ`, `l = 1`, `e = (2, 3)` the produced `m` vanishes
  at index `1` and is nonzero at index `0`, since `M_Q ≠ 0`.
* The simplicity argument fails without `e ≠ 0`: for `e = 0` the zero submodule
  satisfies the hypothesis but is not `M_Q` (hostile control).
-/

namespace AlgebraicAnalysisTest.GoldieSplitting

noncomputable section

open AlgebraicAnalysis AlgebraicAnalysis.Goldie AlgebraicAnalysisTest.GoldieRank
open MulOpposite nonZeroDivisors

/-! ## Embedding the regular module -/

/-- Over `ℚ`, the module `ℚ²` contains a copy of `ℚ`; the produced vector is
nonzero, since `a ↦ a • 0` is not injective. -/
theorem exists_ne_zero_rat_two : ∃ x : Fin 2 → ℚ, x ≠ 0 := by
  have h : Module.length ℚ ℚ ≤ Module.length ℚ (Fin 2 → ℚ) := by
    rw [Module.length_eq_finrank ℚ ℚ, Module.length_eq_finrank ℚ (Fin 2 → ℚ)]
    simp
  obtain ⟨x, hx⟩ := exists_injective_smul_of_length_le h
  refine ⟨x, fun h0 => ?_⟩
  have : (0 : ℚ) = 1 := hx (by simp [h0])
  exact zero_ne_one this

/-- Hostile control: the zero module has length `0 < 1 = length ℚ`, and no orbit
map into it is injective. -/
example : ¬ ∃ x : PUnit.{1}, Function.Injective fun a : ℚ => a • x := by
  rintro ⟨x, hx⟩
  exact zero_ne_one (hx (Subsingleton.elim _ _))

/-! ## Splitting off `R_R` -/

theorem goldieRank_rat_prod : goldieRank ℚ (ℚ × ℚ) = 2 := by
  rw [goldieRank_prod, goldieRank_rat]
  rfl

/-- Independent check: `ℚ × ℚ` is not generated by one element. -/
theorem not_cyclic_rat_prod (p : ℚ × ℚ) : Submodule.span ℚᵐᵒᵖ {p} ≠ ⊤ := by
  intro h
  have h1 : ((1 : ℚ), (0 : ℚ)) ∈ Submodule.span ℚᵐᵒᵖ {p} := h ▸ Submodule.mem_top
  have h2 : ((0 : ℚ), (1 : ℚ)) ∈ Submodule.span ℚᵐᵒᵖ {p} := h ▸ Submodule.mem_top
  obtain ⟨a, ha⟩ := Submodule.mem_span_singleton.mp h1
  obtain ⟨b, hb⟩ := Submodule.mem_span_singleton.mp h2
  have ha1 : p.1 * unop a = 1 := congrArg Prod.fst ha
  have ha2 : p.2 * unop a = 0 := congrArg Prod.snd ha
  have hb1 : p.1 * unop b = 0 := congrArg Prod.fst hb
  have hb2 : p.2 * unop b = 1 := congrArg Prod.snd hb
  have hp1 : p.1 ≠ 0 := left_ne_zero_of_mul_eq_one ha1
  have hp2 : p.2 ≠ 0 := left_ne_zero_of_mul_eq_one hb2
  have : unop a = 0 := (mul_eq_zero.mp ha2).resolve_left hp2
  rw [this, mul_zero] at ha1
  exact zero_ne_one ha1

/-- The splitting leaves a quotient of rank exactly one, which is therefore
nonzero, consistent with `not_cyclic_rat_prod`. -/
theorem exists_goldieRank_quotient_eq_one :
    ∃ p : ℚ × ℚ, goldieRank ℚ ((ℚ × ℚ) ⧸ Submodule.span ℚᵐᵒᵖ {p}) = 1 := by
  obtain ⟨p, hp⟩ := exists_goldieRank_eq_add_quotient (R := ℚ) (M := ℚ × ℚ)
    (by rw [goldieRank_rat, goldieRank_rat_prod]; decide)
  refine ⟨p, ?_⟩
  rw [goldieRank_rat_prod, goldieRank_rat] at hp
  have hne : goldieRank ℚ ((ℚ × ℚ) ⧸ Submodule.span ℚᵐᵒᵖ {p}) ≠ ⊤ := goldieRank_ne_top
  generalize goldieRank ℚ ((ℚ × ℚ) ⧸ Submodule.span ℚᵐᵒᵖ {p}) = r at hp hne ⊢
  lift r to ℕ using hne
  norm_cast at hp ⊢
  omega

/-- The free cyclic submodule of `ℚ × ℚ` is generated by a nonzero element. -/
example : ∃ p : ℚ × ℚ, p ≠ 0 := by
  obtain ⟨p, hp⟩ := exists_injective_toSpanSingleton (R := ℚ) (M := ℚ × ℚ)
    (by rw [goldieRank_rat, goldieRank_rat_prod]; decide)
  refine ⟨p, fun h0 => ?_⟩
  have : (1 : ℚᵐᵒᵖ) = 0 := hp (by simp [h0])
  exact one_ne_zero this

/-! ## Successive choice -/

theorem fractionModule_rat_ne_bot : (⊥ : Submodule (OppositeQuotientRing ℚ)
    (FractionModule ℚ ℚ)) ≠ ⊤ := by
  intro h
  have h0 : goldieRank ℚ ℚ = 0 := by
    rw [goldieRank, ← Module.length_top, ← h, Module.length_bot]
  rw [goldieRank_rat] at h0
  exact one_ne_zero h0

/-- With `e = (2, 3)` and `rk(ℚ) = 1 < 2`, the produced `m` vanishes at index
`1` and is nonzero at index `0`. -/
theorem exists_span_fraction_rat :
    ∃ m : Fin 2 → ℚ, m 1 = 0 ∧ m 0 ≠ 0 := by
  obtain ⟨m, hm0, hspan⟩ := exists_span_fraction_eq_top (R := ℚ) (M := ℚ) (l := 1)
    ![2, 3] (by intro j; fin_cases j <;> norm_num) (by decide) goldieRank_rat
  have h1 : m 1 = 0 := hm0 1 le_rfl
  refine ⟨m, h1, fun h0 => fractionModule_rat_ne_bot ?_⟩
  rw [← hspan, eq_comm, Submodule.span_eq_bot]
  rintro _ ⟨j, rfl⟩
  fin_cases j <;> simp [h0, h1]

/-- Hostile control: without `e ≠ 0` the simplicity argument fails, because for
`e = 0` the zero submodule contains every `toFrac(m e) = 0`. -/
example : ∃ U : Submodule (OppositeQuotientRing ℚ) (FractionModule ℚ ℚ),
    (∀ m : ℚ, toFractionModule ℚ ℚ (op (0 : ℚ) • m) ∈ U) ∧ U ≠ ⊤ :=
  ⟨⊥, fun m => by simp, fractionModule_rat_ne_bot⟩

end

end AlgebraicAnalysisTest.GoldieSplitting

